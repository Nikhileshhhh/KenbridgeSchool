---
// "Related" link pair at the foot of the Information pages (Rules, Decorum, Song, Prayer boards):
// two large rows side by side on desktop, stacked on phones (no arrow on phones, as drawn).
import Icon from '../ui/Icon.astro';

interface Props { items: { title: string; desc: string; href: string }[]; class?: string }
const { items, class: cls } = Astro.props;
---
<nav class:list={['rel', cls]} aria-label="Related">
  {items.map((it) => (
    <a class="rel-link" href={it.href}>
      <span class="rel-text"><span class="rel-t">{it.title}</span><span class="rel-d">{it.desc}</span></span>
      <Icon name="arrow" size={24} class="rel-arrow only-lg" />
    </a>
  ))}
</nav>

<style>
  .rel { display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .rel-link { display: flex; justify-content: space-between; align-items: center; min-height: 88px; padding: 0 var(--margin); border-bottom: 1px solid var(--border); color: var(--text); text-decoration: none; }
  .rel-link:last-child { border-bottom: 0; }
  .rel-link:hover { color: var(--text); }
  .rel-link:hover .rel-t { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .rel-text { display: flex; flex-direction: column; gap: 4px; }
  .rel-t { font-family: var(--font-display); font-size: 30px; font-weight: 500; line-height: 1; }
  .rel-d { font-size: 14px; color: var(--text-muted); }
  .rel :global(.rel-arrow) { flex-shrink: 0; color: var(--brand); }
  @media (min-width: 1024px) {
    .rel { grid-template-columns: 1fr 1fr; }
    .rel-link { min-height: 120px; padding: 0 40px; border-bottom: 0; border-right: 1px solid var(--border); }
    .rel-t { font-size: 40px; }
  }
</style>
