---
// EnquiryForm (EnquiryForm board; AdmissionsFormStates). Used on /admissions only when
// settings.admissions.enquiryOnPage is true. Every state renders on the server, so the dev review
// page can show them side by side; scripts/enquiry.js adds validation, the focused error summary and,
// in demo mode, an honest "nothing was sent" notice. Values are always kept on failure.
// Without JS in demo mode the Send button is replaced by a note to call or email the school.
import Field from '../ui/Field.astro';
import Icon from '../ui/Icon.astro';
import '../../styles/forms.css';
import { getMain, getSchool, getSettings } from '../../lib/site';

type State = 'idle' | 'errors' | 'sending' | 'success' | 'failed';
interface Values { name?: string; email?: string; phone?: string; cls?: string; msg?: string }
interface Props { state?: State; values?: Values; compact?: boolean; labelledBy?: string; idPrefix?: string }
const { state = 'idle', values = {}, compact = false, labelledBy, idPrefix = 'enq' } = Astro.props;

const { classes } = await getMain('admissions');
const school = await getSchool();
const { forms } = await getSettings();
const phone = school.phones[0];
const id = (k: string) => `${idPrefix}${k}`;

// The board's validation rules, run here only to render the "errors" review state.
function validate(v: Values) {
  const e: Record<string, string> = {};
  if (!v.name?.trim()) e.name = 'Enter the parent’s or guardian’s name';
  if (!v.email?.trim()) e.email = 'Enter an email address';
  else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.email.trim())) e.email = 'Enter an email address in the format name@example.com';
  const digits = (v.phone ?? '').replace(/\D/g, '').replace(/^91(?=\d{10}$)/, '');
  if (!digits) e.phone = 'Enter a mobile number';
  else if (digits.length !== 10) e.phone = 'Enter a 10-digit mobile number';
  if (!v.cls) e.cls = 'Choose the class you are enquiring about';
  return e;
}
const errs = state === 'errors' ? validate(values) : {};
const order: [keyof Values, string][] = [['name', 'Name'], ['email', 'Email'], ['phone', 'Phone'], ['cls', 'Class'], ['msg', 'Msg']];
const errorList = order.filter(([k]) => errs[k]).map(([k, s]) => ({ id: id(s), msg: errs[k] }));
const options = [{ value: '', label: 'Choose a class' }, ...classes.map((c) => ({ value: c, label: c }))];
const first = values.name?.split(' ')[0];
---
<div class:list={['enq', compact && 'enq--compact']} data-enquiry-root>
  {state === 'success' ? (
    <div class="enq-success" role="status" tabindex="-1" data-enquiry-success>
      <p class="enq-success-k"><Icon name="success" size={22} />Enquiry sent</p>
      <h3 class="enq-success-h">Thank you{first && `, ${first}`}. Your enquiry has reached the admissions office.</h3>
      <dl class="enq-success-dl">
        <dt>Class sought</dt><dd>{values.cls || '—'}</dd>
        <dt>We’ll reply to</dt><dd class="enq-anywhere">{values.email || '—'}</dd>
      </dl>
      <p class="enq-muted">For anything urgent, call admissions on <a class="tnum" href={`tel:${phone.tel}`}>{phone.display}</a>.</p>
      <button type="button" class="enq-again" data-enquiry-reset>Send another enquiry</button>
    </div>
  ) : (
    <form class="enq-form" method="post" aria-labelledby={labelledBy} data-enquiry data-mode={forms.mode}>
      <div class="enq-summary" role="alert" tabindex="-1" data-enquiry-summary hidden={!errorList.length}>
        <strong class="enq-summary-t"><Icon name="error" size={20} /><span data-enquiry-summary-title>{errorList.length === 1 ? 'There is 1 problem with this form' : `There are ${errorList.length} problems with this form`}</span></strong>
        <ul class="enq-summary-list" data-enquiry-summary-list>
          {errorList.map((er) => <li><a href={`#${er.id}`}>{er.msg}</a></li>)}
        </ul>
      </div>

      {state === 'failed' && (
        <div class="enq-failed" role="alert">
          <Icon name="error" size={20} />
          <p><strong>Your enquiry could not be sent.</strong> Nothing you typed has been lost. Try again, or call admissions on <a class="tnum" href={`tel:${phone.tel}`}>{phone.display}</a>.</p>
        </div>
      )}

      <div class="enq-demo" role="status" tabindex="-1" data-enquiry-demo hidden>
        <Icon name="error" size={20} />
        <p><strong>Preview: this form is not connected yet, so nothing was sent.</strong> Your details are still here. To enquire now, call admissions on <a class="tnum" href={`tel:${phone.tel}`}>{phone.display}</a> or email <a href={`mailto:${school.email}`}>{school.email}</a>.</p>
      </div>

      <div class="enq-fields">
        <Field id={id('Name')} name="name" label="Parent’s or guardian’s name" autocomplete="name" value={values.name} error={errs.name} requiredMsg="Enter the parent’s or guardian’s name" />
        <Field id={id('Email')} name="email" label="Email address" type="email" autocomplete="email" inputmode="email" value={values.email} error={errs.email} requiredMsg="Enter an email address" formatMsg="Enter an email address in the format name@example.com" />
        <Field id={id('Phone')} name="phone" label="Mobile number" type="tel" autocomplete="tel" inputmode="tel" hint="10 digits, for example 98765 43210" value={values.phone} error={errs.phone} requiredMsg="Enter a mobile number" formatMsg="Enter a 10-digit mobile number" />
        <Field id={id('Class')} name="cls" label="Class sought" as="select" options={options} hint="Check the age criteria above before you choose." value={values.cls} error={errs.cls} requiredMsg="Choose the class you are enquiring about" />
        <Field id={id('Msg')} name="msg" label="Message" as="textarea" optional wide value={values.msg} />
      </div>

      <div class="enq-actions">
        {state === 'sending' ? (
          <button type="submit" class="enq-submit enq-submit--sending" disabled>
            <svg class="enq-spin" aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M10 2.5A7.5 7.5 0 1 1 2.5 10" /></svg>Sending…
          </button>
        ) : (
          <button type="submit" class:list={['enq-submit', forms.mode === 'demo' && 'js-only']} data-enquiry-submit>{state === 'failed' ? 'Try again' : 'Send enquiry'}</button>
        )}
        <p class="enq-muted enq-privacy">Your details are used only to reply to this enquiry.</p>
      </div>
      {forms.mode === 'demo' && (
        <p class="enq-nojs no-js-only">This preview form is not connected yet. To enquire, call admissions on <a class="tnum" href={`tel:${phone.tel}`}>{phone.display}</a> or email <a href={`mailto:${school.email}`}>{school.email}</a>.</p>
      )}
      <p class="vh" aria-live="polite" data-enquiry-live>{state === 'sending' ? 'Sending your enquiry' : state === 'failed' ? 'Your enquiry could not be sent' : ''}</p>
    </form>
  )}
</div>
