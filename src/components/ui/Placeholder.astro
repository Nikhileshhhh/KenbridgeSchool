---
// A missing photo, portrait or video, shown exactly as the board words it, e.g.
// "[Photo · Drone-Front.jpg · school front, architectural]". Every label used on the site
// is tracked in website/PLACEHOLDERS.md. Square corners, no shadow (Content board).
//
// When the label's photo has been supplied (src/assets/photos/, matched as in src/lib/photos.ts),
// the real photograph renders instead, in the same frame: AVIF and WebP with a JPEG fallback, a
// width ladder with srcset, explicit width and height, lazy unless `priority`. Its alt text comes
// from src/data/photos.yaml; the build stops rather than invent one.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { findPhoto } from '../../lib/photos';

interface Props {
  label: string;
  /** The supplied file, when the label alone cannot say (e.g. "[Album cover]" for a given album). */
  file?: string;
  ratio?: string;
  tone?: 1 | 2 | 3 | 4 | 'dark';
  /** Accessible description; defaults to "Placeholder: <label>". */
  alt?: string;
  /** Overrides the photo's alt text, e.g. "" where visible text already names it. */
  photoAlt?: string;
  class?: string;
  corners?: boolean;
  /** Above the fold (a hero): load eagerly with high priority. */
  priority?: boolean;
  /** The image's displayed width, for srcset selection. */
  sizes?: string;
  /** false keeps the placeholder even when the photo is supplied (e.g. a banner held back until transcribed). */
  photo?: boolean;
}
const { label, file, ratio = '3 / 2', tone = 1, alt, photoAlt: altOverride, class: cls, corners = false, priority = false, sizes = '100vw', photo = true } = Astro.props;

const found = photo ? await findPhoto({ label, file }) : undefined;
const src: ImageMetadata | undefined = found?.src;
const photoAlt = altOverride ?? found?.alt ?? '';
---
{src ? (
  <div class:list={['ph', 'ph--photo', cls]} style={`aspect-ratio:${ratio}`}>
    <Picture
      src={src}
      alt={photoAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={src.width < 390 ? [src.width] : [390, 640, 960, 1280, 1920, 2880].filter((w) => w <= src.width)}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
      class="ph-img"
    />
  </div>
) : (
  <div
    class:list={['ph', tone === 'dark' && 'ph--dark', cls]}
    style={`aspect-ratio:${ratio};${tone === 'dark' ? '' : `background:var(--ph-${tone})`}`}
    role="img"
    aria-label={alt ?? `Placeholder: ${label.replace(/^\[|\]$/g, '')}`}
  >
    {corners && <><span class="ph-c ph-c--tl"></span><span class="ph-c ph-c--tr"></span><span class="ph-c ph-c--bl"></span><span class="ph-c ph-c--br"></span></>}
    <span class="ph-label">{label}</span>
  </div>
)}

<style>
  .ph {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
    padding: 16px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-muted);
  }
  /* A photograph fills its frame: page styles that pad the placeholder label do not apply. */
  .ph.ph--photo { padding: 0 !important; overflow: hidden; background: var(--ph-1); }
  .ph--photo :global(picture), .ph--photo :global(.ph-img) { display: block; width: 100%; height: 100%; }
  .ph--photo :global(.ph-img) { object-fit: cover; }
  .ph--dark { background: var(--ph-dark); color: var(--text-on-dark-muted); }
  .ph-c { position: absolute; width: 24px; height: 24px; border-color: var(--text-on-dark-muted); border-style: solid; border-width: 0; }
  .ph-c--tl { left: 32px; top: 32px; border-left-width: 1px; border-top-width: 1px; }
  .ph-c--tr { right: 32px; top: 32px; border-right-width: 1px; border-top-width: 1px; }
  .ph-c--bl { left: 32px; bottom: 32px; border-left-width: 1px; border-bottom-width: 1px; }
  .ph-c--br { right: 32px; bottom: 32px; border-right-width: 1px; border-bottom-width: 1px; }
</style>
