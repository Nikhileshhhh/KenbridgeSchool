---
// Line icons drawn on the boards (16px grid). Always decorative: the text beside
// the icon carries the meaning, so every icon is aria-hidden.
interface Props {
  name:
    | 'phone' | 'whatsapp' | 'mail' | 'people' | 'youtube' | 'mobile' | 'external' | 'arrow'
    | 'arrow-left' | 'arrow-up' | 'arrow-down' | 'download' | 'expand' | 'chevron-down' | 'chevron-right' | 'search' | 'close' | 'menu'
    | 'plus' | 'minus' | 'user' | 'briefcase' | 'play' | 'check' | 'error' | 'success' | 'print';
  size?: number;
  class?: string;
  strokeWidth?: number;
}
const { name, size = 16, class: cls, strokeWidth } = Astro.props;

const icons: Record<string, { d: string; sw: number; join?: boolean; cap?: boolean; extra?: string }> = {
  phone: { d: 'M3 2.5H5.5L6.7 5.5L5.1 6.6A7.5 7.5 0 0 0 9.4 10.9L10.5 9.3L13.5 10.5V13A1 1 0 0 1 12.5 14A11.5 11.5 0 0 1 2 3.5A1 1 0 0 1 3 2.5Z', sw: 1.4, join: true },
  whatsapp: { d: 'M8 2.5A5.5 5.5 0 0 0 3.2 10.7L2.5 13.5L5.4 12.8A5.5 5.5 0 1 0 8 2.5Z', sw: 1.4, join: true },
  mail: { d: 'M2 3.5H14V12.5H2Z M2 3.5L8 8.5L14 3.5', sw: 1.4, join: true },
  pin: { d: 'M8 14.5S3 9.6 3 6.3A5 5 0 0 1 13 6.3C13 9.6 8 14.5 8 14.5Z', sw: 1.4, join: true, extra: '<circle cx="8" cy="6.3" r="1.8"/>' },
  directions: { d: 'M8 1.5L14.5 8L8 14.5L1.5 8Z M6 10V8.2H10M8.6 6.6L10 8.2L8.6 9.8', sw: 1.6, cap: true, join: true },
  people: { d: 'M1.5 13.5A4.5 4.5 0 0 1 10.5 13.5M10.5 2.7A2.5 2.5 0 0 1 10.5 7.3M12 9.3A4.5 4.5 0 0 1 14.5 13.5', sw: 1.4, cap: true, extra: '<circle cx="6" cy="5" r="2.5"/>' },
  youtube: { d: '', sw: 1.4, join: true, extra: '<rect x="1.5" y="3.5" width="13" height="9" rx="2"/><path d="M6.5 6V10L10 8Z" fill="currentColor"/>' },
  mobile: { d: 'M7 12.5H9', sw: 1.4, cap: true, extra: '<rect x="4" y="1.5" width="8" height="13" rx="1.5"/>' },
  external: { d: 'M5 3H13V11M13 3L3.5 12.5', sw: 1.6, cap: true, join: true },
  arrow: { d: 'M2.5 8H13M9 4L13 8L9 12', sw: 1.6, cap: true, join: true },
  'arrow-left': { d: 'M13.5 8H3M7 4L3 8L7 12', sw: 1.6, cap: true, join: true },
  'arrow-up': { d: 'M8 13V3M4 7L8 3L12 7', sw: 1.6, cap: true, join: true },
  'arrow-down': { d: 'M8 2.5V13M4 9L8 13L12 9', sw: 1.6, cap: true, join: true },
  'chevron-down': { d: 'M4 6L8 10L12 6', sw: 1.8, cap: true, join: true },
  'chevron-right': { d: 'M6 4L10 8L6 12', sw: 1.5, cap: true },
  search: { d: 'M10.5 10.5L14 14', sw: 1.6, cap: true, extra: '<circle cx="7" cy="7" r="4.5"/>' },
  close: { d: 'M4 4L12 12M12 4L4 12', sw: 1.6, cap: true },
  menu: { d: 'M2.5 4.5H13.5M2.5 8H13.5M2.5 11.5H13.5', sw: 1.5, cap: true },
  plus: { d: 'M3 8H13M8 3V13', sw: 1.8, cap: true },
  minus: { d: 'M3 8H13', sw: 1.8, cap: true },
  user: { d: 'M3 14A5 5 0 0 1 13 14', sw: 1.4, cap: true, extra: '<circle cx="8" cy="5.5" r="2.5"/>' },
  briefcase: { d: 'M5.5 4.5V3A1 1 0 0 1 6.5 2H9.5A1 1 0 0 1 10.5 3V4.5', sw: 1.4, join: true, extra: '<rect x="2" y="4.5" width="12" height="9" rx="1"/>' },
  play: { d: '', sw: 0, extra: '<path d="M5 3.5V12.5L12.5 8Z" fill="currentColor" stroke="none"/>' },
  check: { d: 'M3 8.4L6.4 11.6L13 4.6', sw: 2, cap: true, join: true },
  download: { d: 'M8 2.5V10M4.5 7L8 10.5L11.5 7M3 13.5H13', sw: 1.5, cap: true, join: true },
  expand: { d: 'M10 2.5H13.5V6M6 13.5H2.5V10M13.5 2.5L9 7M2.5 13.5L7 9', sw: 1.8, cap: true },
  print: { d: 'M4.5 6V2.5H11.5V6M4.5 11.5H2.5V6H13.5V11.5H11.5M4.5 9.5H11.5V13.5H4.5Z', sw: 1.4, join: true }
};
const filled: Record<string, string> = {
  error: '<circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M10 5.5V11M10 14V14.1" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>',
  success: '<circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M6 10.4L8.7 13L14 7.5" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>'
};
const icon = icons[name];
---
{filled[name] ? (
  <svg class={cls} aria-hidden="true" focusable="false" width={size} height={size} viewBox="0 0 20 20" set:html={filled[name]} />
) : (
  <svg
    class={cls}
    aria-hidden="true"
    focusable="false"
    width={size}
    height={size}
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth ?? icon.sw}
    stroke-linecap={icon.cap ? 'round' : undefined}
    stroke-linejoin={icon.join ? 'round' : undefined}
    set:html={(icon.d ? `<path d="${icon.d}"/>` : '') + (icon.extra ?? '')}
  />
)}
