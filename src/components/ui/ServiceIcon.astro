---
// 24px line glyphs for service rows and shortcut tiles (ServicesDesktop, ContactDesktop). Maroon stroke.
interface Props { name: string; size?: number; class?: string }
const { name, size = 30, class: cls } = Astro.props;
const glyphs: Record<string, string> = {
  enquiry: '<path d="M4 4H16V20H4Z"/><path d="M7.5 8H12.5M7.5 11.5H12.5M7.5 15H10.5"/><path d="M14.5 13L20 7.5L21.5 9L16 14.5L14 15Z"/>',
  parents: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20A6.5 6.5 0 0 1 15.5 20"/><circle cx="17.5" cy="10" r="2.5"/><path d="M16 14.5A5 5 0 0 1 21.5 19"/>',
  staff: '<rect x="3.5" y="7" width="17" height="12.5" rx="1.5"/><path d="M9 7V4.5H15V7M3.5 12.5H20.5M11 12.5V14.5H13V12.5"/>',
  upload: '<path d="M6 3H14.5L19 7.5V21H6Z"/><path d="M14 3V8H19"/><path d="M12.5 17.5V11.5M10 14L12.5 11.5L15 14"/>',
  video: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M10.5 9.5V14.5L14.5 12Z"/>',
  follow: '<circle cx="8" cy="8" r="4.5"/><path d="M8 5.5V10.5M5.5 8H10.5"/><rect x="12" y="12.5" width="9.5" height="7" rx="1.8"/><path d="M15.8 14.5V17.5L18.3 16Z"/>',
  certificate: '<path d="M6 3H14.5L19 7.5V21H6Z"/><path d="M14 3V8H19"/><path d="M9 13H16M9 16.5H13.5"/>',
  fees: '<rect x="3.5" y="5" width="17" height="14" rx="1.5"/><path d="M3.5 9.5H20.5M7 14.5H11"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="1.5"/><path d="M3.5 9.5H20.5M8 3V6.5M16 3V6.5M7.5 13H9M11.5 13H13M15.5 13H17M7.5 16.5H9M11.5 16.5H13"/>',
  brochure: '<path d="M3.5 5.5C6 4.5 9 4.5 12 6C15 4.5 18 4.5 20.5 5.5V19C18 18 15 18 12 19.5C9 18 6 18 3.5 19Z"/><path d="M12 6V19.5"/>',
  app: '<rect x="6.5" y="2.5" width="11" height="19" rx="2"/><path d="M10.5 18.5H13.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7V12L15.5 14"/>'
};
const g = glyphs[name];
if (!g) throw new Error(`ServiceIcon: unknown glyph "${name}"`);
---
<svg class={cls} aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="#7F0305" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={g} />
