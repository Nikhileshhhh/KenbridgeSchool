---
// Components board · Text field, all states. 52px tall, 17px text (no iOS zoom),
// --border-strong outline, radius 4. Label always visible above; hint and error are tied
// to the control with aria-describedby; the error carries an icon and words.
import Icon from './Icon.astro';

interface Option { value: string; label: string }
interface Props {
  id: string;
  name: string;
  label: string;
  as?: 'input' | 'select' | 'textarea';
  type?: string;
  autocomplete?: string;
  inputmode?: string;
  hint?: string;
  error?: string;
  value?: string;
  optional?: boolean;
  options?: Option[];
  rows?: number;
  wide?: boolean;
  /** Messages the form script shows (forms.js); the field's type decides the format check. */
  requiredMsg?: string;
  formatMsg?: string;
}
const {
  id, name, label, as = 'input', type = 'text', autocomplete, inputmode, hint, error, value = '',
  optional = false, options = [], rows = 4, wide = false, requiredMsg, formatMsg
} = Astro.props;
const msgs = { 'data-required-msg': requiredMsg, 'data-format-msg': formatMsg };
const hintId = `${id}-h`;
const errId = `${id}-e`;
const describedBy = [hint && hintId, errId].filter(Boolean).join(' ');
---
<div class:list={['field', wide && 'field--wide', error && 'has-error']} data-field>
  <label for={id} class="field-label">{label}{optional && <span class="field-opt"> (optional)</span>}</label>
  {hint && <span id={hintId} class="field-hint">{hint}</span>}
  <span id={errId} class="field-error" data-field-error hidden={!error}>
    <Icon name="error" size={18} /><span data-field-error-text>{error}</span>
  </span>
  {as === 'select' ? (
    <span class="field-select">
      <select id={id} name={name} class="field-control" {...msgs} required={!optional} aria-describedby={describedBy} aria-invalid={error ? 'true' : undefined}>
        {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
      </select>
      <Icon name="chevron-down" class="field-chev" />
    </span>
  ) : as === 'textarea' ? (
    <textarea id={id} name={name} rows={rows} class="field-control field-area" {...msgs} required={!optional} aria-describedby={describedBy} aria-invalid={error ? 'true' : undefined}>{value}</textarea>
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      value={value}
      autocomplete={autocomplete}
      inputmode={inputmode}
      class="field-control"
      {...msgs}
      required={!optional}
      aria-describedby={describedBy}
      aria-invalid={error ? 'true' : undefined}
    />
  )}
</div>

<style>
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field-label { font-size: 15px; font-weight: 600; line-height: 1.35; }
  .field-opt { font-weight: 500; color: var(--text-muted); }
  .field-hint { font-size: 14px; line-height: 1.35; color: var(--text-muted); }
  .field-error { display: flex; align-items: flex-start; gap: 8px; font-size: 14px; font-weight: 600; line-height: 1.4; color: var(--error); }
  .field-error[hidden] { display: none; }
  .field-error :global(svg) { flex-shrink: 0; }
  .field-control {
    width: 100%;
    height: 52px;
    padding: 0 16px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font-size: 17px;
    font-variant-numeric: tabular-nums;
  }
  .field-control:hover { border-color: var(--text-muted); }
  .field-control:focus { border-color: var(--text); outline: 2px solid var(--focus); outline-offset: 2px; }
  .field-control[aria-invalid='true'] { border: 2px solid var(--error); padding-left: 15px; }
  .field-control:disabled { border-color: var(--border); background: var(--surface-disabled); color: var(--text-disabled); }
  .field-area { height: auto; min-height: 128px; padding: 14px 16px; line-height: 1.5; resize: vertical; }
  .field-select { position: relative; display: block; }
  .field-select select { appearance: none; padding-right: 48px; }
  .field-select :global(.field-chev) { position: absolute; right: 18px; top: 18px; pointer-events: none; }
</style>
