---
// HomeDesktop §13 / HomeMobile closing identity scene. The emblem returns (400px / 260px) and
// replays its arrival on entry; meaning is hidden here.
import Emblem from '../emblem/Emblem.astro';
import Icon from '../ui/Icon.astro';
import { getHome, getSchool } from '../../lib/site';
const { closing } = await getHome();
const school = await getSchool();
---
<section class="closing on-dark" aria-labelledby="closingTitle">
  <div class="container closing-inner">
    <Emblem size={400} sizeSm={260} live />
    <h2 id="closingTitle" class="closing-title">Inspiring <span class="em">to</span> Learn.</h2>
    <div class="closing-actions">
      <a class="closing-btn closing-btn--ivory" href={closing.visit.href}>{closing.visit.label}</a>
      <a class="closing-btn closing-btn--outline" href={`tel:${school.phones[0].tel}`}><Icon name="phone" class="only-lg" />Call the school</a>
    </div>
  </div>
</section>

<style>
  .closing { background: var(--surface-dark); color: var(--text-on-dark); padding: 64px 0 72px; }
  .closing-inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; }
  .closing-title { font-family: var(--font-display); font-size: clamp(3.5rem, 2.2rem + 5.333vw, 7rem); font-weight: 500; line-height: 0.95; letter-spacing: -0.02em; }
  .closing-actions { width: 100%; display: flex; flex-direction: column; gap: 24px; }
  .closing-btn {
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; height: 52px;
    border-radius: var(--radius-md); font-size: 16px; text-decoration: none;
  }
  .closing-btn--ivory { background: var(--bg); color: var(--brand-strong); font-weight: 700; }
  .closing-btn--ivory:hover { color: var(--brand-strong); background: #FFFFFF; }
  .closing-btn--outline { border: 1.5px solid var(--text-on-dark); color: var(--text-on-dark); font-weight: 600; }
  .closing-btn--outline:hover { color: var(--text-on-dark); background: rgba(251, 247, 240, 0.08); }
  @media (min-width: 1024px) {
    .closing { padding: 128px 0 136px; }
    .closing-inner { gap: 36px; }
    .closing-actions { width: auto; flex-direction: row; gap: 16px; }
    .closing-btn { width: auto; height: 56px; font-size: 17px; }
    .closing-btn--ivory { padding: 0 28px; }
    .closing-btn--outline { padding: 0 26px; }
  }
</style>
