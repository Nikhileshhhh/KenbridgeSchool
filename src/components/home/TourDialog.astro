---
// HomeDesktop / HomeMobile virtual tour modal. Without JS the "Take the virtual tour" controls are
// plain links to YouTube (new tab). With JS they open this native <dialog>: focus goes to Close,
// Esc and the backdrop close it, focus returns to the opener. Nothing from YouTube loads until the
// visitor presses "Play the tour": then (with JS) the video plays here in YouTube's privacy-enhanced
// player (youtube-nocookie.com), which is removed again on close. Without JS it opens on YouTube.
import Icon from '../ui/Icon.astro';
import { getServices } from '../../lib/site';
interface Props { titleSm?: string; noteSm?: string }
// Phone wording differs by page: Home says "Virtual tour"; Campus says "Virtual tour of the campus" and keeps a note.
const { titleSm = 'Virtual tour', noteSm } = Astro.props;
const services = await getServices();
const videoId = new URL(services.virtualTour.url).searchParams.get('v') ?? '';
---
<dialog class="tour on-dark" aria-labelledby="tourTitle" data-tour-dialog>
  <div class="tour-head">
    <h2 id="tourTitle" class="tour-title"><span class="only-lg">Virtual tour of the KenBridge campus</span><span class="only-sm">{titleSm}</span></h2>
    <button type="button" class="tour-close" data-tour-close autofocus>Close<Icon name="close" size={14} /></button>
  </div>
  <div class="tour-frame" data-tour-frame>
    <a class="tour-play" href={services.virtualTour.url} target="_blank" rel="noopener" data-tour-play data-video={videoId}><Icon name="play" size={22} />Play the tour<span class="vh" data-tour-note> (opens YouTube in a new tab)</span></a>
  </div>
  <p class="tour-note only-lg">Captions available on YouTube. Press Esc to close.</p>
  {noteSm && <p class="tour-note tour-note--sm only-sm">{noteSm}</p>}
</dialog>

<style>
  .tour {
    width: calc(100% - 24px);
    max-width: 1000px;
    margin: 140px auto auto;
    padding: 16px;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--surface-dark);
    color: var(--text-on-dark);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.6);
    --focus-ring: var(--focus-on-dark);
  }
  .tour[open] { display: flex; flex-direction: column; gap: 14px; }
  .tour::backdrop { background: rgba(31, 26, 23, 0.82); }
  .tour-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .tour-title { font-family: var(--font-display); font-size: 24px; font-weight: 500; line-height: 1.1; }
  .tour-close {
    display: inline-flex; align-items: center; gap: 6px; height: 44px; padding: 0 12px;
    border: 1px solid rgba(251, 247, 240, 0.45); border-radius: var(--radius-md); background: transparent; color: var(--text-on-dark); font-size: 15px; font-weight: 600;
  }
  .tour-frame { position: relative; aspect-ratio: 16 / 9; background: var(--ph-dark); display: flex; align-items: center; justify-content: center; }
  .tour-frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .tour-play {
    display: inline-flex; align-items: center; gap: 8px; height: 52px; padding: 0 20px;
    border-radius: var(--radius-md); background: var(--accent); color: var(--text) !important; font-size: 16px; font-weight: 700; text-decoration: none;
  }
  .tour-play[hidden] { display: none; }
  .tour-note { font-size: 14px; color: var(--text-on-dark-muted); }
  .tour-note--sm { font-size: 13px; }
  @media (min-width: 1024px) {
    .tour { width: 1000px; margin-top: 200px; padding: 24px 24px 28px; }
    .tour[open] { gap: 20px; }
    .tour-title { font-size: 32px; }
    .tour-close { gap: 8px; padding: 0 14px; }
    .tour-play { gap: 12px; height: 64px; padding: 0 28px 0 22px; font-size: 18px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .tour[open] { animation: kb-sheet 320ms var(--ease-out) both; }
  }
</style>
