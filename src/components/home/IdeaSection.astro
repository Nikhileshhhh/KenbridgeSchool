---
// HomeDesktop §3 / HomeMobile "The KenBridge idea".
import FlameMark from '../ui/FlameMark.astro';
import TextLink from '../ui/TextLink.astro';
import { getHome } from '../../lib/site';
const { idea } = await getHome();
---
<section class="idea" aria-labelledby="ideaTitle">
  <div class="container idea-grid">
    <div class="idea-label">
      <h2 id="ideaTitle" class="idea-h eyebrow-text"><FlameMark size={14} />The KenBridge idea</h2>
    </div>
    <blockquote class="idea-quote">
      <span aria-hidden="true" class="idea-mark">“</span>{idea.quoteStart} <span class="em">{idea.quoteEm}</span>.<span aria-hidden="true" class="idea-mark">”</span>
    </blockquote>
    <div class="idea-body">
      <p>{idea.body}</p>
      <TextLink href="/about">Read our story</TextLink>
    </div>
  </div>
</section>

<style>
  .idea { padding: 64px 0; }
  .idea-grid { display: flex; flex-direction: column; gap: 24px; }
  .idea-h { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 12px; color: var(--brand); }
  .idea-quote { margin: 0; font-family: var(--font-display); font-size: var(--fs-h1); font-weight: 500; line-height: 1.1; letter-spacing: -0.01em; text-wrap: balance; }
  .idea-mark { color: var(--accent); }
  .idea-body { display: flex; flex-direction: column; gap: 24px; padding-top: 20px; border-top: 1px solid var(--text); }
  .idea-body p { font-size: 17px; line-height: 1.65; }
  .idea-body :global(.tlink) { align-self: flex-start; font-size: 16px; }
  @media (min-width: 1024px) {
    .idea { padding: 128px 0; }
    .idea-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 32px; row-gap: 56px; }
    .idea-label { grid-column: 1 / span 2; padding-top: 14px; }
    .idea-h { gap: 10px; font-size: 13px; }
    .idea-quote { grid-column: 3 / span 9; line-height: 1.08; }
    .idea-body { grid-column: 7 / span 5; padding-top: 24px; }
    .idea-body p { font-size: 18px; }
    .idea-body :global(.tlink) { font-size: 17px; }
  }
</style>
