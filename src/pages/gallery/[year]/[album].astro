---
// /gallery/[year]/[album] (GalleryAlbum, GalleryAlbumMobile, GalleryLightbox ×4). Masonry is a CSS
// grid on 4px rows with each photo's span taken from its ratio; items stay in list order, so reading
// and Tab order match what you see. Spans are computed for the board widths and refined by JS on
// resize. The lightbox is a native <dialog>: counter, caption, ← → Esc, swipe, neighbour preload,
// loading and failed + Try again, focus returns to the thumbnail. Without JS the photos are a plain grid.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/shell/Breadcrumbs.astro';
import Icon from '../../../components/ui/Icon.astro';
import { getMain } from '../../../lib/site';

export async function getStaticPaths() {
  const G = await getMain('gallery');
  return G.albums.map((a) => ({ params: { year: a.year, album: a.slug }, props: { slug: a.slug, year: a.year } }));
}
const { slug, year } = Astro.props;
const G = await getMain('gallery');
const a = G.albums.find((x) => x.slug === slug && x.year === year)!;
const total = a.photos.length;
const pad = (n: number) => String(n).padStart(2, '0');
const tones = ['--ph-1', '--ph-2', '--ph-3', '--ph-4'];
// Board geometry: 4 columns in 1312px with 16px gaps (desktop); 2 in 350px with 10px gaps (phones).
const colD = (1312 - 16 * 3) / 4;
const colM = (350 - 10) / 2;
const photos = a.photos.map((p, i) => {
  const n = i + 1;
  const hD = Math.round(colD / p.ratio);
  const hM = Math.round(colM / p.ratio);
  return {
    n, n2: pad(n), file: p.file, ratio: p.ratio,
    alt: p.alt ?? `[Alt text for photo ${n}: who and what is in the picture]`,
    caption: p.caption ?? `[Caption for photo ${n} from the school: the moment, the class or house, the performance.]`,
    spanD: Math.ceil((hD + 16) / 4), spanM: Math.ceil((hM + 10) / 4)
  };
});
const crumbs = [{ label: 'Gallery', href: '/gallery' }, { label: year, href: `/gallery/${year}` }, { label: a.name }];
const ld = [{ label: 'Home', href: '/' }, ...crumbs];
---
<BaseLayout
  title={`${a.name} ${year}`}
  description={`${a.name}, ${year}: ${total} photos from KenBridge School, Kalaburagi.`}
  current="gallery"
  breadcrumbs={ld}
  search="Album"
>
  <div data-album data-name={a.name} data-year={year} data-total={total} data-dev={import.meta.env.DEV ? 'true' : undefined}>
    <section class="al-head" aria-labelledby="albumTitle">
      <div class="container al-head-in">
        <Breadcrumbs items={crumbs} noCollapse />
        <div class="al-head-row">
          <div class="al-head-t">
            <h1 id="albumTitle" class="al-h1">{a.name}</h1>
            <dl class="al-meta tnum">
              <div><dt>Date</dt><dd>{a.date}</dd></div>
              <div><dt>Photos</dt><dd>{total}</dd></div>
              <div><dt>Academic year</dt><dd>{year}</dd></div>
            </dl>
          </div>
          <a class="al-link tnum" href={`/gallery/${year}`}><Icon name="arrow-left" size={16} />Back to {year}</a>
        </div>
      </div>
    </section>

    <section class="container al-grid-wrap" aria-label="Photos">
      <ul class="al-grid" role="list" data-masonry>
        {photos.map((p, i) => (
          <li class="al-item" style={`--sd:${p.spanD};--sm:${p.spanM};--ratio:${p.ratio}`} data-ratio={p.ratio}>
            <button type="button" class="al-thumb js-only" aria-haspopup="dialog" aria-label={`Open photo ${p.n} of ${total}: ${p.alt}`} data-lb-open={i} data-file={p.file} data-alt={p.alt} data-caption={p.caption} style={`background:var(${tones[i % 4]})`}>
              <span class="al-thumb-img"><span aria-hidden="true">[{p.n2} · {p.file}]</span></span>
            </button>
            <div class="al-thumb al-thumb--static no-js-only" role="img" aria-label={p.alt} style={`background:var(${tones[i % 4]})`}>
              <span class="al-thumb-img"><span aria-hidden="true">[{p.n2} · {p.file}]</span></span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <nav class="al-more" aria-label={`More from ${year}`}>
      <div class="container al-more-in">
        <h2 class="al-more-h tnum">More from {year}</h2>
        <ul class="al-more-list" role="list">
          {a.more.map((m) => (
            <li><a class="al-more-tile" href={`/gallery/${year}`}><span class="al-more-cover" role="img" aria-label={`Cover photo placeholder: ${m}`}>[Cover · {m}]</span><span class="al-more-text"><span class="al-more-name">{m}</span><span class="al-more-meta tnum">{year} · [n] photos</span></span></a></li>
          ))}
        </ul>
        <a class="al-back tnum" href={`/gallery/${year}`}><Icon name="arrow-left" size={16} />Back to {year}</a>
      </div>
    </nav>
  </div>

  <dialog class="lb on-dark" aria-labelledby="lbCounter" aria-describedby="lbCaption" data-lightbox>
    <div class="lb-top">
      <p id="lbCounter" class="lb-counter tnum"><span class="vh">{a.name} {year}, photo </span><span data-lb-n>1</span> / {total}</p>
      <button type="button" class="lb-btn lb-close" data-lb-close>Close<Icon name="close" size={14} /></button>
    </div>
    <div class="lb-stage" data-lb-stage>
      <button type="button" class="lb-btn lb-nav lb-prev only-lg" aria-label="Previous photo" data-lb-prev><Icon name="chevron-right" size={20} class="lb-flip" /></button>
      <div class="lb-img" role="img" data-lb-img><span aria-hidden="true" data-lb-label></span></div>
      <div class="lb-loading" role="status" data-lb-loading hidden>
        <svg class="lb-spin" aria-hidden="true" width="36" height="36" viewBox="0 0 20 20" fill="none" stroke="#FBF7F0" stroke-width="1.8" stroke-linecap="round"><path d="M10 2.5A7.5 7.5 0 1 1 2.5 10" /></svg>
        <p class="lb-loading-p">Loading photo <span data-lb-n>1</span> of {total}…</p>
        <span class="lb-loading-ph" aria-hidden="true">[the small thumbnail shows here, softly blurred, until the full photo arrives]</span>
      </div>
      <div class="lb-failed" role="alert" data-lb-failed hidden>
        <svg aria-hidden="true" width="44" height="36" viewBox="0 0 56 44" fill="none" stroke="#CDBFB4" stroke-width="1.5" stroke-linejoin="round"><rect x="1" y="7" width="46" height="36" /><path d="M1 35L15 22L25 31L33 24L47 36" /><path d="M38 2L54 18M54 2L38 18" /></svg>
        <p class="lb-failed-t">This photo could not be loaded.</p>
        <p class="lb-failed-p">Check your connection and try again, or move on to the next photo.</p>
        <div class="lb-failed-actions">
          <button type="button" class="lb-btn lb-text lb-text--strong" data-lb-retry>Try again</button>
          <button type="button" class="lb-btn lb-text" data-lb-next>Next photo</button>
        </div>
      </div>
      <button type="button" class="lb-btn lb-nav lb-next only-lg" aria-label="Next photo" data-lb-next><Icon name="chevron-right" size={20} /></button>
    </div>
    <div class="lb-bottom">
      <p id="lbCaption" class="lb-caption" data-lb-caption></p>
      <div class="lb-mnav only-sm">
        <button type="button" class="lb-btn lb-text" data-lb-prev><Icon name="chevron-right" size={16} class="lb-flip" />Previous</button>
        <button type="button" class="lb-btn lb-text" data-lb-next>Next<Icon name="chevron-right" size={16} /></button>
      </div>
      <p class="lb-hint"><span class="only-sm">Swipe left or right to move between photos</span><span class="only-lg">← → to move · Esc to close</span></p>
    </div>
    <p class="vh" aria-live="polite" data-lb-live></p>
  </dialog>
</BaseLayout>

<script>
  import '../../../scripts/album.js';
</script>

<style>
  .al-head { padding: 12px 0 28px; }
  .al-head-in { display: flex; flex-direction: column; gap: 18px; }
  .al-head-row { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; padding-bottom: 18px; border-bottom: 1px solid var(--text); }
  .al-head-t { display: flex; flex-direction: column; gap: 14px; }
  .al-h1 { font-family: var(--font-display); font-size: clamp(4rem, 2.514rem + 6.095vw, 8rem); font-weight: 500; line-height: 0.9; letter-spacing: -0.02em; }
  .al-meta { margin: 0; display: flex; flex-wrap: wrap; gap: 6px 28px; font-size: 15px; }
  .al-meta div { display: flex; gap: 8px; }
  .al-meta dt { color: var(--text-muted); }
  .al-meta dd { margin: 0; font-weight: 600; }
  .al-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 16px; font-weight: 600; color: var(--brand); text-decoration: underline; text-decoration-color: var(--link-underline); text-underline-offset: 6px; }

  .al-grid-wrap { padding-bottom: 40px; }
  .al-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 4px; column-gap: 10px; }
  .al-item { grid-row: span var(--sm); }
  .al-thumb { display: block; width: 100%; height: calc(100% - 10px); padding: 0; border: 0; overflow: hidden; text-align: left; }
  .al-thumb-img { display: flex; align-items: flex-end; width: 100%; height: 100%; padding: 8px; font-size: 11px; line-height: 1.3; color: var(--text-muted); }
  .al-thumb:focus-visible { outline-offset: 3px; }
  @media (prefers-reduced-motion: no-preference) {
    .al-thumb-img { transition: transform 400ms cubic-bezier(.22, 1, .36, 1); }
    button.al-thumb:hover .al-thumb-img { transform: scale(1.03); }
  }

  .al-more { padding: 40px 0 56px; border-top: 1px solid var(--border); }
  .al-more-in { display: flex; flex-direction: column; gap: 24px; }
  .al-more-h { font-family: var(--font-display); font-size: clamp(2rem, 1.571rem + 1.714vw, 2.75rem); font-weight: 500; line-height: 1; }
  .al-more-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px 10px; }
  .al-more-tile { display: flex; flex-direction: column; gap: 10px; color: var(--text); text-decoration: none; }
  .al-more-tile:hover { color: var(--text); }
  .al-more-tile:hover .al-more-name { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .al-more-cover { aspect-ratio: 3 / 2; background: var(--ph-1); display: flex; align-items: flex-end; padding: 8px; font-size: 11px; color: var(--text-muted); }
  .al-more-text { display: flex; flex-direction: column; gap: 2px; }
  .al-more-name { font-family: var(--font-display); font-size: 24px; font-weight: 500; line-height: 1.1; }
  .al-more-meta { font-size: 13px; color: var(--text-muted); }
  .al-back { align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 20px 0 16px; border: 1.5px solid var(--brand); border-radius: var(--radius-md); color: var(--brand); font-size: 16px; font-weight: 600; text-decoration: none; }
  .al-back:hover { background: var(--brand-tint); color: var(--brand); }

  /* ---------- lightbox ---------- */
  .lb { width: 100%; max-width: 100%; height: 100%; max-height: 100%; margin: 0; padding: 0; border: 0; background: #1C0607; color: var(--text-on-dark); --focus-ring: var(--focus-on-dark); }
  .lb[open] { display: grid; grid-template-rows: auto 1fr auto; }
  .lb::backdrop { background: #1C0607; }
  .lb-top { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; }
  .lb-counter { font-size: 15px; font-weight: 700; letter-spacing: 0.08em; }
  .lb-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid rgba(251, 247, 240, 0.5); border-radius: var(--radius-md); background: transparent; color: var(--text-on-dark); font-size: 15px; font-weight: 600; }
  .lb-btn:hover:not([aria-disabled='true']) { background: rgba(251, 247, 240, 0.14); }
  .lb-btn[aria-disabled='true'] { opacity: 0.35; cursor: default; }
  .lb-close { height: 48px; padding: 0 16px; }
  .lb :global(.lb-flip) { transform: rotate(180deg); }
  .lb-stage { position: relative; min-height: 0; display: flex; align-items: center; justify-content: center; padding: 8px 0; touch-action: pan-y; }
  .lb-img, .lb-loading, .lb-failed { width: auto; height: min(calc(100vh - 300px), var(--fit)); max-width: 100%; aspect-ratio: var(--ratio); }
  .lb-img { background: var(--ph-dark); display: flex; align-items: flex-end; padding: 12px; font-size: 13px; line-height: 1.4; color: var(--text-on-dark-muted); }
  .lb-img[hidden], .lb-loading[hidden], .lb-failed[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) { .lb-img.is-in { animation: kb-fade 220ms ease-out both; } }
  .lb-loading { position: relative; background: linear-gradient(135deg, #3B1416, #4A2420); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; }
  .lb-loading-p { font-size: 15px; color: #E8DCCF; }
  .lb-loading-ph { position: absolute; left: 14px; bottom: 12px; font-size: 12px; color: var(--text-on-dark-muted); }
  @media (prefers-reduced-motion: no-preference) { .lb-spin { animation: lb-spin 900ms linear infinite; transform-origin: 50% 50%; } }
  @keyframes lb-spin { to { transform: rotate(360deg); } }
  .lb-failed { border: 1px dashed rgba(251, 247, 240, 0.4); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 24px; text-align: center; }
  .lb-failed-t { font-family: var(--font-display); font-size: 28px; font-weight: 500; }
  .lb-failed-p { font-size: 15px; color: var(--text-on-dark-muted); }
  .lb-failed-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .lb-text { min-height: 48px; padding: 0 18px; }
  .lb-text--strong { border-color: var(--text-on-dark); }
  .lb-bottom { display: flex; flex-direction: column; gap: 14px; padding: 12px 16px 20px; }
  .lb-caption { max-width: 820px; font-size: 15px; line-height: 1.5; }
  .lb-mnav { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .lb-mnav .lb-text { min-height: 52px; }
  .lb-hint { font-size: 13px; color: var(--text-on-dark-muted); text-align: center; }

  @media (min-width: 1024px) {
    .al-head { padding: 28px 0 48px; }
    .al-head-in { gap: 28px; }
    .al-head-row { flex-direction: row; justify-content: space-between; align-items: flex-end; padding-bottom: 28px; }
    .al-grid-wrap { padding-bottom: 96px; }
    .al-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 16px; }
    .al-item { grid-row: span var(--sd); }
    .al-thumb { height: calc(100% - 16px); }
    .al-more { padding: 72px 0 104px; }
    .al-more-list { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 16px; }
    .al-more-name { font-size: 30px; }

    .lb-top { padding: 20px 32px; }
    .lb-stage { padding: 0 120px; }
    .lb-img, .lb-loading, .lb-failed { height: min(calc(100vh - 200px), var(--fit)); }
    .lb-img { padding: 14px; }
    .lb-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 56px; height: 56px; border-radius: 50%; }
    .lb-prev { left: 32px; }
    .lb-next { right: 32px; }
    .lb-bottom { padding: 18px 120px 28px; }
    .lb-caption { font-size: 17px; }
    .lb-hint { text-align: left; }
  }
</style>
