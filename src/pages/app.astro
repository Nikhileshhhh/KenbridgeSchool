---
// /app: the target of the QR code on /services (ServicesDesktop: "Opens the right store for your phone,
// via kenbridgegulbarga.com/app"). Not drawn as its own board. On Android or iOS a small inline script
// sends the visitor straight to the right store; everyone else (desktop, or JS off) sees both store
// links, styled like the app card on /services.
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceIcon from '../components/ui/ServiceIcon.astro';
import { getMain, getServices } from '../lib/site';

const { services: S } = await getMain('contact');
const services = await getServices();
const play = services.androidApp.url;
const apple = services.iosApp.url;
---
<BaseLayout
  title={S.app.title}
  description="Get the KBS Gulbarga app for families on Google Play or the App Store."
  search={false}
  noindex
>
  <script is:inline define:vars={{ play, apple }}>
    var ua = navigator.userAgent;
    if (/android/i.test(ua)) location.replace(play);
    else if (/iphone|ipad|ipod/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)) location.replace(apple);
  </script>
  <div class="container ap-wrap">
    <section class="ap-card" aria-labelledby="apH1">
      <div class="ap-head">
        <ServiceIcon name="app" />
        <div class="ap-t">
          <h1 id="apH1" class="ap-h1">{S.app.title}</h1>
          <p class="ap-p">{S.app.lead} Choose your store:</p>
        </div>
      </div>
      <div class="ap-badges">
        <a class="ap-badge" href={play} target="_blank" rel="noopener"><span aria-hidden="true">{S.app.playBadge}</span><span class="vh">KBS Gulbarga on Google Play (play.google.com, opens in a new tab)</span></a>
        <a class="ap-badge" href={apple} target="_blank" rel="noopener"><span aria-hidden="true">{S.app.appleBadge}</span><span class="vh">KBS Gulbarga on the App Store (apps.apple.com, opens in a new tab)</span></a>
      </div>
      <p class="ap-back"><a href="/services">All online services</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .ap-wrap { padding-top: 40px; padding-bottom: 64px; }
  .ap-card { max-width: 560px; display: flex; flex-direction: column; gap: 20px; padding: 22px 18px; background: var(--surface); border: 1px solid var(--border); box-shadow: inset 0 4px 0 var(--accent); }
  .ap-head { display: flex; gap: 14px; align-items: flex-start; }
  .ap-head :global(svg) { flex-shrink: 0; }
  .ap-t { display: flex; flex-direction: column; gap: 6px; }
  .ap-h1 { font-family: var(--font-display); font-size: 36px; font-weight: 500; line-height: 1.05; }
  .ap-p { font-size: 16px; line-height: 1.55; color: var(--text-muted); }
  .ap-badges { display: flex; flex-direction: column; gap: 10px; }
  .ap-badge { display: inline-flex; align-items: center; justify-content: center; width: 100%; height: 56px; padding: 0 10px; border-radius: var(--radius-md); background: var(--text); color: #FFFFFF; text-decoration: none; font-size: 12px; line-height: 1.3; text-align: center; }
  .ap-badge:hover { background: #000000; color: #FFFFFF; }
  .ap-back a { display: inline-flex; align-items: center; min-height: 44px; color: var(--brand); font-weight: 600; }
  @media (min-width: 640px) {
    .ap-wrap { padding-top: 96px; padding-bottom: 128px; }
    .ap-card { padding: 32px; margin-inline: auto; }
    .ap-h1 { font-size: 44px; }
    .ap-badges { flex-direction: row; }
    .ap-badge { width: 220px; }
  }
</style>
