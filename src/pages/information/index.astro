---
// /information · School Information (InformationDesktop, InformationMobile). Static rows of links, the
// downloads (a PDF with no file yet shows its [size] and no link) and the office-hours card.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/shell/Breadcrumbs.astro';
import Icon from '../../components/ui/Icon.astro';
import { getMain, getSchool, getServices } from '../../lib/site';

const { hub } = await getMain('info');
const school = await getSchool();
const services = await getServices();
const phone = school.phones[0];
const icons: Record<string, string> = {
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7V12L15.5 14"/>',
  list: '<path d="M9 6H20M9 12H20M9 18H20"/><path d="M4 5.5H5.5V8M4 8H6.5M4 11.5H6.5L4 14.5H6.5M4 17H6.5V20H4M4.5 18.5H6.5"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="1.5"/><path d="M3.5 9.5H20.5M8 3V6.5M16 3V6.5M8.5 14.5L11 17L15.5 12.5"/>',
  music: '<path d="M9 18V5.5L19 3.5V16"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/>',
  flame: '<path d="M12 3C12 3 16 7.2 16 10.4C16 12.6 14.2 14.4 12 14.4C9.8 14.4 8 12.6 8 10.4C8 7.2 12 3 12 3Z"/><path d="M5 17.5C7 16.5 9.5 16 12 16S17 16.5 19 17.5L17.5 21H6.5Z"/>',
  shield: '<path d="M12 3L19.5 6V11.5C19.5 16 16.3 19.6 12 21C7.7 19.6 4.5 16 4.5 11.5V6Z"/><path d="M8.5 12L11 14.5L15.5 10"/>',
  pdf: '<path d="M6 3H14.5L19 7.5V21H6Z"/><path d="M14 3V8H19"/><path d="M9 12.5V17M9 12.5H10.5A1.5 1.5 0 0 1 10.5 15.5H9"/><path d="M14 12.5V17M14 12.5H16"/><path d="M14 14.6H15.6"/>',
  external: '<path d="M13.5 4H20V10.5M20 4L11 13"/><path d="M17 14V20H4V7H10"/>'
};
const downloads = hub.downloads.map((d) => {
  const s = d.service ? services[d.service] : undefined;
  return { ...d, href: s?.url, size: s?.size ?? '[size]', domain: s?.domain };
});
const crumbs = [{ label: 'Home', href: '/' }, { label: 'School Information' }];
---
<BaseLayout
  title="School Information"
  description="School timings, rules, decorum, the school song and prayer, the CBSE Mandatory Public Disclosure, downloads and office hours at KenBridge School, Kalaburagi."
  current="information"
  breadcrumbs={crumbs}
>
  <section class="if-hero" aria-labelledby="infoH1">
    <div class="container if-hero-in">
      <Breadcrumbs items={crumbs} collapse />
      <div class="if-hero-row">
        <h1 id="infoH1" class="if-h1">{hub.title}</h1>
        <p class="if-lead">{hub.lead}</p>
      </div>
    </div>
  </section>

  <div class="container if-body">
    <div class="if-groups">
      {hub.groups.map((g, gi) => (
        <section class="if-group" aria-labelledby={`g${gi}`}>
          <h2 id={`g${gi}`} class="if-group-h">{g.label}</h2>
          <ul class="if-rows" role="list">
            {g.items.map((it) => (
              <li>
                <a class="if-row" href={it.href}>
                  <svg class="if-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="#7F0305" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[it.icon]} />
                  <span class="if-row-text">
                    <span class="if-row-t">{it.title}</span>
                    <span class="if-row-d">{it.quote ? <><em class="if-q">“{it.quote}”</em>{it.by && ` ${it.by}`}</> : it.desc}</span>
                  </span>
                  <Icon name="arrow" size={20} class="if-arrow" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="if-group" aria-labelledby="gdownloads">
        <h2 id="gdownloads" class="if-group-h">Downloads</h2>
        <ul class="if-rows" role="list">
          {downloads.map((d) => {
            const inner = (
              <>
                <svg class="if-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="#7F0305" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[d.kind === 'pdf' ? 'pdf' : 'external']} />
                <span class="if-row-text">
                  <span class="if-row-t if-row-t--sm">{d.title}<span class="vh">{d.kind === 'pdf' ? ` (PDF, ${d.size}${d.href ? ', opens in a new tab' : ', file not yet available'})` : ' (external site, opens in a new tab)'}</span></span>
                  <span class="if-row-d if-row-d--sm">{d.desc}<span class="only-sm"> · <strong class="if-strong">{d.kind === 'pdf' ? 'PDF' : 'External'}</strong> · {d.kind === 'pdf' ? d.size : d.domain}</span></span>
                </span>
                <span class="if-meta only-lg"><span class:list={['if-chip', d.kind === 'external' && 'if-chip--ext']}>{d.kind === 'pdf' ? 'PDF' : 'EXTERNAL'}</span>{d.kind === 'pdf' ? d.size : d.domain}</span>
                {d.href ? <Icon name={d.kind === 'pdf' ? 'download' : 'external'} size={20} class="if-arrow" /> : <span class="if-arrow-gap" aria-hidden="true"></span>}
              </>
            );
            return <li>{d.href ? <a class="if-row if-row--dl" href={d.href} target="_blank" rel="noopener">{inner}</a> : <div class="if-row if-row--dl if-row--off">{inner}</div>}</li>;
          })}
        </ul>
        <p class="if-legend">
          <span><Icon name="download" size={14} /> PDF: downloads a file</span>
          <span><Icon name="external" size={13} /> External: opens another site in a new tab</span>
        </p>
      </section>
    </div>

    <div class="if-side">
      <aside class="if-hours" aria-labelledby="hoursTitle">
        <h2 id="hoursTitle" class="if-hours-h"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="#7F0305" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons.clock} />Office hours</h2>
        <table class="if-hours-t tnum">
          <caption class="vh">School office working hours</caption>
          <tbody>{school.hours.map((h) => <tr><th scope="row">{h.days}</th><td class:list={[h.time === 'Holiday' && 'if-muted']}>{h.time}</td></tr>)}</tbody>
        </table>
        <p class="if-hours-p">{school.principalMeeting}</p>
        <div class="if-hours-links">
          <a class="if-link tnum" href={`tel:${phone.tel}`}><span class="vh">Call the school office, </span>{phone.display}</a>
          <a class="if-link if-mail" href={`mailto:${school.email}`}>{school.email}</a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .if-muted { color: var(--text-muted); }
  .if-hero { padding: 12px 0 36px; border-bottom: 1px solid var(--border); }
  .if-hero-in { display: flex; flex-direction: column; gap: 12px; }
  .if-hero-row { display: flex; flex-direction: column; gap: 12px; }
  .if-h1 { font-family: var(--font-display); font-size: clamp(3.25rem, 2.229rem + 4.19vw, 5.5rem); font-weight: 500; line-height: 0.98; }
  .if-lead { font-size: 18px; line-height: 1.5; color: var(--text-muted); }

  .if-body { padding-top: 32px; padding-bottom: 64px; display: flex; flex-direction: column; gap: 40px; }
  .if-groups { display: flex; flex-direction: column; gap: 40px; }
  .if-group { display: flex; flex-direction: column; }
  .if-group-h { padding-bottom: 12px; border-bottom: 1px solid var(--text); font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand); }
  .if-rows { list-style: none; margin: 0; padding: 0; }
  .if-row { display: grid; grid-template-columns: 32px 1fr 20px; gap: 14px; align-items: center; min-height: 84px; padding: 16px 0; border-bottom: 1px solid var(--border); color: var(--text); text-decoration: none; }
  .if-row--dl { min-height: 80px; padding: 14px 0; }
  a.if-row:hover { background: var(--surface-raised); color: var(--text); }
  a.if-row:hover .if-row-t { color: var(--brand); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; }
  .if-icon { width: 26px; height: 26px; flex-shrink: 0; }
  .if-row-text { display: flex; flex-direction: column; gap: 4px; line-height: 1.4; }
  .if-row-t { font-family: var(--font-display); font-size: 28px; font-weight: 500; line-height: 1.1; }
  .if-row-t--sm { font-size: 24px; }
  .if-row-d { font-size: 15px; line-height: 1.5; color: var(--text-muted); }
  .if-row-d--sm { font-size: 14px; }
  .if-strong { color: var(--text); }
  .if-q { font-style: italic; }
  .if-row :global(.if-arrow) { flex-shrink: 0; color: var(--brand); }
  .if-meta { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-muted); white-space: nowrap; }
  .if-chip { display: inline-flex; align-items: center; height: 26px; padding: 0 8px; border: 1px solid var(--border-strong); border-radius: 3px; background: var(--brand-tint); font-size: 12px; font-weight: 800; letter-spacing: 0.08em; color: var(--text); }
  .if-chip--ext { background: var(--surface); }
  .if-legend { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 13px; color: var(--text-muted); }
  .if-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .if-legend :global(svg) { color: var(--brand); }

  .if-hours { display: flex; flex-direction: column; gap: 18px; padding: 24px 20px; background: var(--surface); border: 1px solid var(--border); box-shadow: inset 0 4px 0 var(--accent); }
  .if-hours-h { display: flex; align-items: center; gap: 12px; font-family: var(--font-display); font-size: 28px; font-weight: 500; line-height: 1.1; }
  .if-hours-h svg { width: 26px; height: 26px; flex-shrink: 0; }
  .if-hours-t { width: 100%; border-collapse: collapse; font-size: 17px; line-height: 1.35; }
  .if-hours-t tr { border-top: 1px solid var(--border); }
  .if-hours-t tr:last-child { border-bottom: 1px solid var(--border); }
  .if-hours-t th { padding: 12px 16px 12px 0; text-align: left; font-weight: 600; }
  .if-hours-t td { padding: 12px 0; text-align: right; }
  .if-hours-p { font-size: 15px; line-height: 1.55; color: var(--text-muted); }
  .if-hours-links { display: flex; flex-direction: column; gap: 4px; }
  .if-link { align-self: flex-start; display: inline-flex; align-items: center; min-height: 44px; font-size: 17px; font-weight: 600; color: var(--brand); text-decoration: underline; text-decoration-color: var(--link-underline); text-underline-offset: 5px; }
  .if-mail { font-size: 16px; overflow-wrap: anywhere; }

  @media (min-width: 1024px) {
    .if-hero { padding: 28px 0 56px; }
    .if-hero-in { gap: 20px; }
    .if-hero-row { flex-direction: row; justify-content: space-between; align-items: flex-end; gap: 48px; padding-top: 16px; }
    .if-h1 { line-height: 0.95; }
    .if-lead { margin-bottom: 10px; max-width: 360px; font-size: 20px; }
    .if-body { padding-top: 64px; padding-bottom: 112px; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 32px; align-items: start; }
    .if-groups { grid-column: 1 / span 8; gap: 56px; }
    .if-row { grid-template-columns: 44px 1fr 24px; gap: 20px; min-height: 96px; padding: 20px 8px 20px 0; }
    .if-row--dl { grid-template-columns: 44px 1fr auto 24px; min-height: 88px; padding: 18px 8px 18px 0; }
    .if-icon { width: 30px; height: 30px; }
    .if-row-t { font-size: 32px; }
    .if-row-t--sm { font-size: 28px; }
    .if-row-d { font-size: 16px; }
    .if-row-d--sm { font-size: 14px; }
    .if-side { grid-column: 9 / span 4; position: sticky; top: 112px; }
    .if-hours { padding: 32px; }
    .if-hours-h { font-size: 32px; }
  }
</style>
