---
// /about · Our Story (AboutDesktop 1–2, AboutMobile 1–2).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/shell/Breadcrumbs.astro';
import FlameMark from '../../components/ui/FlameMark.astro';
import Icon from '../../components/ui/Icon.astro';
import NextLinks from '../../components/ui/NextLinks.astro';
import Emblem from '../../components/emblem/Emblem.astro';
import { getMain, getHome } from '../../lib/site';

const about = await getMain('about');
const founder = await getMain('founder');
const principal = await getMain('principal');
const { vision, mission } = await getHome();
const crumbs = [{ label: 'Home', href: '/' }, { label: 'About' }];
// Timeline geometry from the board: the arc bulges right; dots sit on it.
const xs = ['58.4px', '85.1px', '98.3px', '98.3px', '85.1px', '58.4px'];
const yearSize = (y: string) => (y.length > 6 ? 76 : y.length > 4 ? 96 : 120);
---
<BaseLayout
  title="Our Story"
  description="Since 2011, a CBSE school serving Kalaburagi and the Kalyana Karnataka region. Founded by the Homi Educational Trust; CBSE affiliated since 2015 (No. 830594)."
  header="hero"
  current="about"
  breadcrumbs={crumbs}
>
  <section class="ab-hero on-dark" aria-labelledby="aboutTitle">
    <div class="ab-hero-bg" role="img" aria-label={about.hero.photoAlt}><div class="ab-hero-shade"></div></div>
    <span class="ab-hero-ph"><span class="only-lg">{about.hero.photo}</span><span class="only-sm">{about.hero.photoSm}</span></span>
    <div class="container ab-hero-grid">
      <div class="ab-hero-copy">
        <Breadcrumbs items={crumbs} onDark />
        <h1 id="aboutTitle" class="ab-h1">{about.hero.title} <span class="em">{about.hero.titleEm}</span></h1>
        <p class="ab-lead">{about.hero.lead}</p>
      </div>
      <dl class="ab-facts only-lg tnum">
        {about.hero.facts.map((f) => <div class="ab-fact"><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="ab-intro" aria-label="Introduction">
    <div class="container ab-intro-grid">
      <span class="ab-intro-label eyebrow-text"><FlameMark size={14} />Introduction</span>
      <p class="ab-intro-p"><span aria-hidden="true" class="ab-drop">{about.intro.charAt(0)}</span><span class="vh">{about.intro.charAt(0)}</span>{about.intro.slice(1)}</p>
    </div>
  </section>

  <section class="ab-tl" aria-labelledby="timelineTitle">
    <div class="container">
      <div class="ab-tl-head">
        <span class="ab-eyebrow eyebrow-text">Milestones</span>
        <h2 id="timelineTitle" class="ab-h2">A school, year by year</h2>
      </div>
      <div class="ab-tl-body">
        <svg class="ab-tl-arc only-lg" aria-hidden="true" focusable="false" viewBox="0 0 140 1440"><path d="M40 0A4350 4350 0 0 1 40 1440" fill="none" stroke="#7F0305" stroke-width="1.5" /></svg>
        <ol role="list" class="ab-tl-list">
          {about.milestones.map((m, i) => (
            <li class="ab-ms" style={`--x:${xs[i]};--ys:${yearSize(m.year)}px;--ysm:${m.year.length > 6 ? 44 : 64}px`}>
              <span class:list={['ab-ms-year', 'tnum', i === 0 && 'is-first']}>{m.year}</span>
              <span class="ab-ms-rail" aria-hidden="true">
                {i < about.milestones.length - 1 && <span class="ab-ms-line only-sm"></span>}
                <span class:list={['ab-ms-dot', i === 0 && 'is-first']}></span>
              </span>
              <span class="ab-ms-text tnum">{m.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="ab-beyond" aria-labelledby="beyondTitle">
    <div class="container ab-beyond-grid">
      <div class="ab-beyond-copy">
        <div class="ab-beyond-head">
          <span class="ab-eyebrow eyebrow-text">Beyond the classroom</span>
          <h2 id="beyondTitle" class="ab-h2">Fields, stages and teams</h2>
        </div>
        <div class="ab-ph ab-ph--wide only-sm" role="img" aria-label={about.beyond.photos[0].alt}>{about.beyond.photos[0].label}</div>
        <div class="ab-lists">
          <div><h3 class="ab-list-h">Sports</h3><ul role="list" class="ab-list">{about.beyond.sports.map((s) => <li>{s}</li>)}</ul></div>
          <div><h3 class="ab-list-h">Activities</h3><ul role="list" class="ab-list">{about.beyond.activities.map((s) => <li>{s}</li>)}</ul></div>
        </div>
      </div>
      <div class="ab-photos">
        {about.beyond.photos.map((p, i) => (
          <figure class:list={['ab-fig', i === 0 && 'ab-fig--wide only-lg']}>
            <div class="ab-ph" role="img" aria-label={p.altSm && i > 0 ? p.altSm : p.alt}>
              <span class="only-lg">{p.label}</span>{p.labelSm && <span class="only-sm">{p.labelSm}</span>}
            </div>
            <figcaption class="ab-cap only-lg">{p.caption}</figcaption>
          </figure>
        ))}
      </div>
      <p class="ab-closing">{about.beyond.closing}</p>
    </div>
  </section>

  <section class="ab-vm" aria-labelledby="visionTitle">
    <div class="container ab-vm-grid">
      <h2 id="visionTitle" class="ab-eyebrow eyebrow-text">Our vision</h2>
      <blockquote class="ab-vm-quote"><span aria-hidden="true" class="ab-mark">“</span>{vision}<span aria-hidden="true" class="ab-mark">”</span></blockquote>
      <h2 class="ab-eyebrow eyebrow-text ab-vm-mission-h">Our mission</h2>
      <ol role="list" class="ab-vm-list">
        {mission.map((m, i) => (
          <li class="ab-vm-item">
            <span class="ab-vm-num"><FlameMark size={20} class="only-lg" /><span class="tnum">{String(i + 1).padStart(2, '0')}</span></span>
            <span class="ab-vm-text">{m}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ab-logo on-dark" aria-labelledby="logoTitle">
    <div class="container ab-logo-grid">
      <div class="ab-logo-copy">
        <div class="ab-logo-head">
          <span class="ab-eyebrow ab-eyebrow--dark eyebrow-text">{about.logo.eyebrow}</span>
          <h2 id="logoTitle" class="ab-h2">{about.logo.title}</h2>
        </div>
        <dl class="ab-ken">
          <div><dt>KEN</dt><dd>{about.logo.ken}</dd></div>
          <div><dt>BRIDGE</dt><dd>{about.logo.bridge}</dd></div>
        </dl>
        <p class="ab-logo-note only-lg js-only">{about.logo.note}</p>
      </div>
      <div class="ab-logo-emblem">
        <Emblem size={520} sizeSm={320} meaning meaningOpen kenLine={false} />
      </div>
    </div>
  </section>

  <section class="ab-lead-wrap" aria-label="Leadership">
    <article class="ab-founder on-dark" aria-labelledby="founderTitle">
      <div class="container ab-founder-grid">
        <div class="ab-founder-id">
          <span class="ab-eyebrow ab-eyebrow--dark eyebrow-text"><FlameMark size={14} onDark class="only-lg" />Our Founder</span>
          <h2 id="founderTitle" class="ab-founder-name">{founder.honorific}<br class="only-lg" /><span class="only-sm"> </span>{founder.name}</h2>
          <div class="ab-founder-rule only-lg" aria-hidden="true"></div>
          <p class="ab-founder-roles">{founder.roles.join(' · ')}</p>
        </div>
        <div class="ab-founder-body">
          <figure class="ab-founder-fig">
            <blockquote class="ab-founder-motto">“{founder.motto}”</blockquote>
            <figcaption>{founder.mottoCaption}</figcaption>
          </figure>
          <p class="ab-founder-p">{founder.excerpt}</p>
          <a class="ab-link-dark" href="/about/founder">Read tribute<Icon name="arrow" class="only-lg" /><span class="only-sm" aria-hidden="true"> →</span></a>
        </div>
      </div>
    </article>
    <article class="ab-principal" aria-labelledby="principalTitle">
      <div class="container ab-principal-grid">
        <figure class="ab-principal-fig">
          <div class="ab-saffron-rule" aria-hidden="true"></div>
          <blockquote class="ab-principal-quote">“{principal.quote}”</blockquote>
          <figcaption>{principal.quoteCaption}</figcaption>
        </figure>
        <div class="ab-principal-body">
          <span class="ab-eyebrow eyebrow-text">Principal’s Message</span>
          <h2 id="principalTitle" class="ab-principal-name"><span class="ab-pn">{principal.name}</span><span class="ab-pq">{principal.qualifications} · Principal</span></h2>
          <p class="ab-principal-p">{principal.excerpt}</p>
          <a class="ab-link" href="/about/principal">Read message<Icon name="arrow" class="only-lg" /><span class="only-sm" aria-hidden="true"> →</span></a>
        </div>
      </div>
    </article>
  </section>

  <NextLinks
    size="l"
    items={[
      { eyebrow: 'Next', label: 'Explore learning', href: '/learning', tone: 'maroon' },
      { eyebrow: 'Admissions', label: 'Admission procedure', href: '/admissions#procedure', tone: 'raised' }
    ]}
  />
</BaseLayout>

<script>
  import '../../scripts/emblem/emblem.js';
</script>

<style>
  .ab-eyebrow { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 12px; color: var(--brand); }
  .ab-eyebrow--dark { color: var(--accent); }
  .ab-h2 { font-family: var(--font-display); font-size: clamp(2.5rem, 1.943rem + 2.286vw, 4rem); font-weight: 500; line-height: 1.05; }
  .em { font-style: italic; }

  /* hero */
  .ab-hero { position: relative; height: 600px; padding-bottom: 40px; background: #3B1416; color: var(--text-on-dark); overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; }
  .ab-hero-bg { position: absolute; inset: 0; background: radial-gradient(ellipse 90% 45% at 50% 40%, rgba(170, 120, 80, 0.4) 0%, rgba(59, 20, 22, 0) 70%), #3B1416; }
  .ab-hero-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(42, 10, 11, 0.94) 0%, rgba(42, 10, 11, 0.4) 55%, rgba(42, 10, 11, 0.2) 100%); }
  .ab-hero-ph { position: absolute; left: var(--margin); top: 84px; font-size: 12px; color: var(--text-on-dark-muted); }
  .ab-hero-grid { position: relative; width: 100%; }
  .ab-hero-copy { display: flex; flex-direction: column; gap: 14px; }
  .ab-hero-copy :global(.breadcrumbs .crumbs) { font-size: 14px; }
  .ab-h1 { font-family: var(--font-display); font-size: clamp(4rem, 2.514rem + 6.095vw, 8rem); font-weight: 500; line-height: 0.92; letter-spacing: -0.02em; }
  .ab-lead { max-width: 640px; font-size: clamp(1.0625rem, 0.97rem + 0.381vw, 1.3125rem); line-height: 1.55; color: #E9DDD3; }
  .ab-facts { margin: 0; display: flex; flex-direction: column; }
  .ab-fact { display: flex; justify-content: space-between; padding: 12px 0; border-top: 1px solid rgba(251, 247, 240, 0.25); }
  .ab-fact:last-child { border-bottom: 1px solid rgba(251, 247, 240, 0.25); }
  .ab-fact dt { font-size: 14px; color: var(--text-on-dark-muted); }
  .ab-fact dd { margin: 0; font-size: 15px; font-weight: 700; }

  /* intro */
  .ab-intro { padding: 64px 0; }
  .ab-intro-grid { display: flex; flex-direction: column; gap: 16px; }
  .ab-intro-label { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--brand); }
  .ab-intro-p { font-family: var(--font-display); font-size: clamp(1.5rem, 1.314rem + 0.762vw, 2rem); font-weight: 500; line-height: 1.45; text-wrap: pretty; }
  .ab-drop { float: left; margin: 6px 10px 0 -2px; font-size: 84px; font-weight: 600; line-height: 0.78; color: var(--brand); }

  /* timeline */
  .ab-tl { padding: 64px 0; background: var(--surface-raised); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .ab-tl-head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 32px; }
  .ab-tl-body { position: relative; }
  .ab-tl-list { list-style: none; margin: 0; padding: 0; }
  .ab-ms { display: grid; grid-template-columns: 28px 1fr; grid-template-rows: auto auto; column-gap: 16px; }
  .ab-ms-rail { grid-column: 1; grid-row: 1 / span 2; position: relative; display: flex; justify-content: center; }
  .ab-ms-line { position: absolute; top: 0; bottom: 0; width: 1.5px; background: var(--brand); }
  .ab-ms-dot { position: relative; margin-top: 18px; width: 14px; height: 14px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 4px var(--surface-raised); }
  .ab-ms-dot.is-first { background: var(--accent); }
  .ab-ms-year { grid-column: 2; padding-top: 0; font-family: var(--font-display); font-size: var(--ysm); font-weight: 500; line-height: 1; color: var(--text); }
  .ab-ms-year.is-first { color: var(--brand); }
  .ab-ms-text { grid-column: 2; padding: 8px 0 36px; font-size: 17px; line-height: 1.55; }

  /* beyond */
  .ab-beyond { padding: 64px 0; }
  .ab-beyond-grid { display: flex; flex-direction: column; gap: 28px; }
  .ab-beyond-copy { display: flex; flex-direction: column; gap: 28px; }
  .ab-beyond-head { display: flex; flex-direction: column; gap: 10px; }
  .ab-lists { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .ab-list-h { margin: 0 0 6px; padding-bottom: 8px; border-bottom: 1px solid var(--text); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }
  .ab-list { list-style: none; margin: 0; padding: 0; font-family: var(--font-display); font-size: clamp(1.375rem, 1.189rem + 0.762vw, 1.75rem); font-weight: 500; line-height: 1.1; }
  .ab-list li { padding: 8px 0; border-bottom: 1px solid var(--border); }
  .ab-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .ab-fig { margin: 0; display: flex; flex-direction: column; }
  .ab-ph { background: var(--ph-1); display: flex; align-items: flex-end; padding: 8px; font-size: 11px; color: var(--text-muted); aspect-ratio: 1 / 1; }
  .ab-ph--wide { aspect-ratio: 3 / 2; padding: 10px; font-size: 12px; }
  .ab-cap { padding-top: 8px; font-size: 13px; color: var(--text-muted); }
  .ab-closing { margin-top: 8px; padding-top: 24px; border-top: 1px solid var(--text); font-family: var(--font-display); font-size: clamp(1.75rem, 1.229rem + 2.133vw, 2.75rem); font-style: italic; line-height: 1.25; }

  /* vision & mission */
  .ab-vm { padding: 72px 0; background: var(--surface-raised); border-top: 1px solid var(--border); }
  .ab-vm-grid { display: flex; flex-direction: column; gap: 20px; }
  .ab-vm-quote { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 1.257rem + 3.048vw, 4rem); font-style: italic; font-weight: 400; line-height: 1.2; }
  .ab-mark { color: var(--accent); }
  .ab-vm-mission-h { margin-top: 48px; }
  .ab-vm-list { list-style: none; margin: 0; padding: 0; }
  .ab-vm-item { display: flex; flex-direction: column; gap: 10px; padding: 24px 0; border-top: 1px solid var(--border); }
  .ab-vm-item:first-child { border-top-color: var(--text); }
  .ab-vm-item:last-child { border-bottom: 1px solid var(--border); }
  .ab-vm-num { display: flex; align-items: center; gap: 12px; font-family: var(--font-display); font-size: clamp(3rem, 2.257rem + 3.048vw, 5rem); line-height: 0.85; color: var(--brand); }
  .ab-vm-text { font-family: var(--font-display); font-size: clamp(1.5rem, 1.221rem + 1.143vw, 2.25rem); font-weight: 500; line-height: 1.3; }

  /* logo explainer */
  .ab-logo { padding: 64px 0; background: var(--surface-dark); color: var(--text-on-dark); }
  .ab-logo-grid { display: flex; flex-direction: column; gap: 24px; }
  .ab-logo-copy { display: flex; flex-direction: column; gap: 24px; }
  .ab-logo-head { display: flex; flex-direction: column; gap: 10px; }
  .ab-ken { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .ab-ken > div { padding-top: 12px; border-top: 1px solid rgba(251, 247, 240, 0.25); }
  .ab-ken dt { font-family: var(--font-display); font-size: clamp(2.25rem, 1.786rem + 1.905vw, 3.5rem); font-weight: 600; letter-spacing: 0.06em; line-height: 1; color: var(--accent); }
  .ab-ken dd { margin: 6px 0 0; font-size: 15px; line-height: 1.4; }
  .ab-logo-note { font-size: 16px; line-height: 1.6; color: var(--text-on-dark-muted); }
  .ab-logo-emblem { display: flex; justify-content: center; }

  /* leadership */
  .ab-founder { padding: 64px 0; background: #3B1416; color: var(--text-on-dark); }
  .ab-founder-grid { display: flex; flex-direction: column; gap: 18px; }
  .ab-founder-id { display: flex; flex-direction: column; gap: 18px; }
  .ab-founder-name { font-family: var(--font-display); font-size: clamp(2.75rem, 2.033rem + 2.933vw, 4.5rem); font-weight: 500; line-height: 1; }
  .ab-founder-rule { width: 96px; height: 1px; background: var(--accent); }
  .ab-founder-roles { font-size: 14px; line-height: 1.6; color: var(--text-on-dark-muted); }
  .ab-founder-body { display: flex; flex-direction: column; gap: 18px; }
  .ab-founder-fig { margin: 12px 0 0; padding-top: 20px; border-top: 1px solid var(--accent); display: flex; flex-direction: column; gap: 6px; }
  .ab-founder-motto { margin: 0; font-family: var(--font-display); font-size: clamp(2.5rem, 1.943rem + 2.286vw, 4rem); font-style: italic; font-weight: 400; line-height: 1; }
  .ab-founder-fig figcaption { font-size: 13px; color: var(--text-on-dark-muted); }
  .ab-founder-p { font-size: 17px; line-height: 1.65; }
  .ab-link-dark, .ab-link {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 16px; font-weight: 600;
    text-decoration: underline; text-underline-offset: 6px;
  }
  .ab-link-dark { color: var(--text-on-dark); text-decoration-color: rgba(251, 247, 240, 0.45); }
  .ab-link-dark:hover { color: var(--text-on-dark); text-decoration-color: var(--accent); }
  .ab-link { color: var(--brand); text-decoration-color: var(--link-underline); }
  .ab-link:hover { text-decoration-thickness: 2px; text-decoration-color: currentColor; }
  .ab-principal { padding: 64px 0; background: var(--bg); }
  .ab-principal-grid { display: flex; flex-direction: column-reverse; gap: 18px; }
  .ab-principal-fig { margin: 8px 0 0; display: flex; flex-direction: column; gap: 8px; }
  .ab-saffron-rule { display: none; width: 96px; height: 2px; background: var(--accent); }
  .ab-principal-fig { padding-top: 20px; border-top: 2px solid var(--accent); }
  .ab-principal-quote { margin: 0; font-family: var(--font-display); font-size: clamp(1.75rem, 1.271rem + 1.962vw, 3rem); font-style: italic; font-weight: 400; line-height: 1.2; }
  .ab-principal-fig figcaption { font-size: 14px; color: var(--text-muted); }
  .ab-principal-body { display: flex; flex-direction: column; gap: 18px; }
  .ab-principal-name { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .ab-pn { font-family: var(--font-display); font-size: clamp(2.5rem, 2.129rem + 1.524vw, 3.5rem); font-weight: 500; line-height: 1; }
  .ab-pq { font-family: var(--font-body); font-size: 15px; font-weight: 600; color: var(--text-muted); }
  .ab-principal-p { font-size: 17px; line-height: 1.65; }
  /* On phones the principal block reads name → quote → excerpt (AboutMobile). */
  @media (max-width: 1023px) {
    .ab-principal-grid { display: flex; flex-direction: column; }
    .ab-principal-body { display: contents; }
    .ab-principal-body > .ab-eyebrow { order: 1; }
    .ab-principal-name { order: 2; }
    .ab-principal-fig { order: 3; }
    .ab-principal-p { order: 4; }
    .ab-principal-body > .ab-link { order: 5; }
  }

  @media (min-width: 1024px) {
    .ab-eyebrow { font-size: 13px; }
    .ab-hero { height: 760px; padding-bottom: 88px; }
    .ab-hero-bg { background: linear-gradient(180deg, rgba(150, 120, 90, 0.35) 0%, rgba(59, 20, 22, 0) 45%), radial-gradient(ellipse 70% 45% at 60% 55%, rgba(170, 120, 80, 0.4) 0%, rgba(59, 20, 22, 0) 70%), #3B1416; }
    .ab-hero-shade { background: linear-gradient(0deg, rgba(42, 10, 11, 0.94) 0%, rgba(42, 10, 11, 0.55) 45%, rgba(42, 10, 11, 0.25) 100%); }
    .ab-hero-ph { left: auto; right: var(--margin); top: 160px; font-size: 13px; }
    .ab-hero-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 32px; align-items: end; }
    .ab-hero-copy { grid-column: span 8; gap: 20px; }
    .ab-hero-copy :global(.breadcrumbs .crumbs) { font-size: 15px; }
    .ab-facts { grid-column: 10 / span 3; }

    .ab-intro { padding: 144px 0 128px; }
    .ab-intro-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 32px; }
    .ab-intro-label { grid-column: 2 / span 2; align-self: start; padding-top: 18px; gap: 10px; font-size: 13px; }
    .ab-intro-p { grid-column: 4 / span 6; }
    .ab-drop { margin: 8px 14px 0 -4px; font-size: 132px; }

    .ab-tl { padding: 128px 0 144px; }
    .ab-tl-head { gap: 14px; margin: 0 0 80px calc((100% - 11 * 32px) / 12 + 32px); }
    .ab-tl-body { margin-left: 96px; }
    .ab-tl-arc { position: absolute; left: 404px; top: 0; width: 140px; height: 1440px; }
    .ab-ms { grid-template-columns: 380px 140px 1fr; grid-template-rows: 240px; column-gap: 24px; align-items: center; height: 240px; }
    .ab-ms-year { grid-column: 1; grid-row: 1; text-align: right; font-size: var(--ys); line-height: 0.9; letter-spacing: -0.02em; }
    .ab-ms-rail { grid-column: 2; grid-row: 1; height: 100%; display: block; }
    .ab-ms-dot { position: absolute; left: var(--x); top: 50%; width: 18px; height: 18px; margin: -9px 0 0 -9px; box-shadow: 0 0 0 5px var(--surface-raised); }
    .ab-ms-text { grid-column: 3; grid-row: 1; padding: 0; max-width: 560px; font-size: 20px; }

    .ab-beyond { padding: 144px 0; }
