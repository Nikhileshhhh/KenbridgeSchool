---
// /campus · Our Campus (CampusDesktop, CampusMobile). Hero over the aerial photo, the campus in figures,
// Learn / Play / Create / Gather tabs, the facility atlas (a live preview on desktop; thumbnails on
// phones) and the virtual tour. Without JS: all four scenes are listed and the atlas is a plain list.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/shell/Breadcrumbs.astro';
import Icon from '../../components/ui/Icon.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import TourDialog from '../../components/home/TourDialog.astro';
import { getMain, getFacilities, getSchool, getServices } from '../../lib/site';

const C = await getMain('campus');
const school = await getSchool();
const services = await getServices();
const facs = (await getFacilities()).map((f) => ({
  slug: f.id,
  num: f.data.num,
  name: f.data.atlasName ?? f.data.name,
  desc: f.data.atlasDesc,
  muted: f.data.atlasPlaceholder,
  previewLabel: `[${f.data.photoNeeded ? 'Photo needed' : 'Photo'} · ${f.data.atlasPhoto}]`,
  thumbLabel: `[${f.data.photoNeeded ? 'Photo needed' : f.data.homePhoto}]`,
  thumbAlt: `Placeholder for a photograph: ${f.data.atlasName ?? f.data.name}${f.data.photoNeeded ? ' (photo needed)' : ` (${f.data.homePhoto})`}`,
  href: `/campus/${f.id}`
}));
const bySlug = Object.fromEntries(facs.map((f) => [f.slug, f]));
const first = facs[0];
const phone = school.phones[0];
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Our Campus' }];
---
<BaseLayout
  title="Our Campus"
  description="The KenBridge School campus, Kalaburagi: five green acres, 72 classrooms, six laboratories, a 150 sq m library, a playground and a multipurpose hall."
  header="hero"
  current="campus"
  breadcrumbs={crumbs}
>
  <section class="cp-hero on-dark" aria-labelledby="campusH1">
    <div class="cp-hero-bg" role="img" aria-label={C.hero.alt}></div>
    <div class="cp-hero-shade" aria-hidden="true"></div>
    <span class="cp-corner cp-corner--l only-lg" aria-hidden="true"></span>
    <span class="cp-corner cp-corner--r only-lg" aria-hidden="true"></span>
    <span class="cp-hero-ph" aria-hidden="true"><span class="only-lg">{C.hero.photo}</span><span class="only-sm">{C.hero.photoSm}</span></span>
    <div class="container cp-hero-copy">
      <Breadcrumbs items={crumbs} onDark collapse />
      <h1 id="campusH1" class="cp-h1">{C.hero.title}</h1>
      <p class="cp-lead">{C.hero.lead}</p>
      <div class="cp-hero-ctas">
        <a class="cp-btn cp-btn--primary" href="#atlas">{C.hero.explore}<Icon name="arrow-down" size={18} /></a>
        <a class="cp-btn cp-btn--outline" href={services.virtualTour.url} target="_blank" rel="noopener" data-tour-open>
          <Icon name="play" size={16} />{C.hero.tour}<span class="vh" data-tour-note> (opens YouTube in a new tab)</span>
        </a>
      </div>
    </div>
  </section>

  <section class="cp-fig" aria-labelledby="figTitle">
    <div class="container">
      <div class="cp-fig-head">
        <h2 id="figTitle" class="eyebrow-text cp-red">{C.figures.title}</h2>
        <p class="cp-fig-source only-lg">{C.figures.source}</p>
      </div>
      <dl class="cp-fig-dl tnum">
        {C.figures.items.map((f, i) => (
          <div class:list={['cp-fig-item', i === 0 && 'cp-fig-item--wide']}>
            <dt>{f.label}{f.note && <><span class="only-lg cp-muted"> · {f.note}</span><br class="only-sm" /><span class="only-sm cp-muted">{f.note}</span></>}</dt>
            <dd>
              {f.icon === 'globe' ? (
                <span class="cp-globe">
                  <svg aria-hidden="true" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-linecap="round"><circle cx="16" cy="16" r="13" /><path d="M3 16H29M16 3C12 7 10.5 11.5 10.5 16S12 25 16 29M16 3C20 7 21.5 11.5 21.5 16S20 25 16 29" /></svg>
                  <span class="vh">{f.value}</span>
                </span>
              ) : (
                <><span class="cp-fig-num">{f.value}</span>{f.unit && <span class="cp-fig-unit">{f.unit}</span>}</>
              )}
            </dd>
          </div>
        ))}
      </dl>
      <p class="cp-fig-source only-sm">{C.figures.source}</p>
    </div>
  </section>

  <section class="cp-scn" aria-labelledby="scnTitle">
    <div class="container" data-tabs>
      <div class="cp-scn-head">
        <div class="cp-scn-title">
          <p class="eyebrow-text cp-red">{C.scenes.eyebrow}</p>
          <h2 id="scnTitle" class="cp-h2">{C.scenes.title}</h2>
        </div>
        <div role="tablist" aria-label="Campus scenes" class="cp-tabs js-only">
          {C.scenes.list.map((s, i) => (
            <button type="button" role="tab" id={`scnTab${i}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`scnPanel${i}`} tabindex={i === 0 ? undefined : '-1'} class="cp-tab">
              <span class="cp-tab-n tnum only-lg" aria-hidden="true">0{i + 1}</span><span class="cp-tab-verb">{s.verb}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="cp-scn-panels">
        {C.scenes.list.map((s, i) => (
          <div id={`scnPanel${i}`} role="tabpanel" aria-labelledby={`scnTab${i}`} tabindex="0" class="cp-scn-panel">
            <Placeholder label={`[Photo · ${s.photo}]`} alt={`Placeholder for a photograph: ${s.photo}`} class="cp-scn-photo swap" />
            <div class="cp-scn-text swap">
              <p class="eyebrow-text cp-red cp-scn-verb">{s.verb}</p>
              <h3 class="cp-h3">{s.places}</h3>
              <p class="cp-scn-p">{s.text}</p>
              <ul class="cp-scn-list" aria-label="In this scene" role="list">
                {s.facilities.map((k) => (
                  <li><a class="cp-scn-link" href={`#fac-${k}`} data-atlas-goto={k}><span class="cp-scn-num tnum">{bySlug[k].num}</span><span class="cp-scn-name">{bySlug[k].name}</span><Icon name="arrow" size={16} /></a></li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="atlas" class="cp-atlas" aria-labelledby="atlasTitle" data-atlas>
    <div class="container">
      <div class="cp-atlas-head">
        <div class="cp-atlas-title">
          <p class="eyebrow-text cp-red tnum">{C.atlas.eyebrow}</p>
          <h2 id="atlasTitle" class="cp-atlas-h2">{C.atlas.title}</h2>
        </div>
        <p class="cp-atlas-hint only-lg js-only">{C.atlas.hint}</p>
      </div>
      <div class="cp-atlas-grid">
        <figure id="atlasPreview" class="cp-preview only-lg">
          <div class="cp-preview-photo swap" role="img" aria-label={`Placeholder for a photograph: ${first.previewLabel.slice(1, -1)}`} data-atlas-photo>
            <span class="cp-preview-num tnum" aria-hidden="true" data-atlas-bignum>{first.num}</span>
            <span data-atlas-label>{first.previewLabel}</span>
          </div>
          <figcaption class="cp-preview-cap" aria-live="polite">
            <span class="cp-preview-id"><span class="cp-preview-n tnum" data-atlas-num>{first.num}</span><span class="cp-preview-name" data-atlas-name>{first.name}</span></span>
            <a class="cp-preview-cta" href={first.href} data-atlas-explore>Explore<span class="vh" data-atlas-vh> {first.name}</span><Icon name="arrow" size={16} /></a>
          </figcaption>
        </figure>

        <div class="cp-atlas-list-wrap">
          <ol class="cp-atlas-list" aria-label="Facilities" role="list">
            {facs.map((f, i) => (
              <li id={`fac-${f.slug}`} class:list={['cp-row', i === 0 && 'is-on']} data-atlas-row data-slug={f.slug} data-num={f.num} data-name={f.name} data-label={f.previewLabel} data-href={f.href}>
                <span class="cp-row-thumb only-sm"><Placeholder label={f.thumbLabel} ratio="4 / 3" alt={f.thumbAlt} class="cp-thumb-ph" /></span>
                <button type="button" class="cp-row-btn js-only only-lg" aria-controls="atlasPreview" aria-pressed={i === 0 ? 'true' : 'false'} data-atlas-pick>
                  <span class="cp-row-num tnum">{f.num}</span><span class="cp-row-name">{f.name}<span class="vh">, show in preview</span></span>
                </button>
                <p class="cp-row-title cp-row-title--static"><span class="cp-row-num tnum">{f.num}</span><span class="cp-row-name">{f.name}</span></p>
                <a class="cp-row-link" href={f.href}>Explore<span class="vh"> {f.name}</span><Icon name="arrow" size={14} /></a>
                <p class:list={['cp-row-desc', f.muted && 'cp-muted']}>{f.desc}</p>
              </li>
            ))}
          </ol>
          <div class="cp-also">
            <span class="cp-also-k">Also</span>
            <div class="cp-also-body">
              <p class="cp-also-name">{C.atlas.also.name}</p>
              <p class="cp-also-p">{C.atlas.also.text} <span class="cp-nowrap">{C.atlas.also.photo}</span></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cp-close" aria-label="Visit the campus">
    <div class="container cp-close-grid">
      <a class="cp-tour on-dark" href={services.virtualTour.url} target="_blank" rel="noopener" data-tour-open>
        <span class="cp-tour-bg" aria-hidden="true"></span>
        <span class="cp-tour-play" aria-hidden="true"><Icon name="play" size={34} /></span>
        <span class="cp-tour-foot">
          <span class="cp-tour-text"><span class="cp-tour-k">{C.closing.tourEyebrow}</span><span class="cp-tour-title">{C.closing.tourTitle}</span></span>
          <span class="cp-tour-thumb only-lg">{C.closing.tourThumb}</span>
        </span>
        <span class="vh" data-tour-note> (opens YouTube in a new tab)</span>
      </a>
      <div class="cp-visit">
        <p class="eyebrow-text cp-red">{C.closing.eyebrow}</p>
        <h2 class="cp-visit-h2">{C.closing.title}</h2>
        <p class="cp-visit-p">{C.closing.text}</p>
        <a class="cp-call tnum" href={`tel:${phone.tel}`}><Icon name="phone" size={18} /><span class="vh">Call </span>{phone.display}</a>
        <a class="cp-link" href={C.closing.directions.href}>{C.closing.directions.label}<Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <TourDialog titleSm="Virtual tour of the campus" noteSm="[YouTube NA7Ksy1WsnY] Captions available on YouTube." ph="[YouTube video NA7Ksy1WsnY · campus tour · privacy-enhanced embed]" />
</BaseLayout>

<script>
  import '../../scripts/campus.js';
</script>

<style>
  .cp-red { color: var(--brand); }
  .cp-muted { color: var(--text-muted); }


  /* ---------- hero ---------- */
  .cp-hero { position: relative; min-height: 700px; padding-bottom: 44px; background: #3B1416; color: var(--text-on-dark); overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; }
  .cp-hero-bg { position: absolute; inset: 0; background: radial-gradient(ellipse 80% 40% at 55% 32%, rgba(96, 110, 60, 0.5) 0%, rgba(59, 20, 22, 0) 70%), radial-gradient(ellipse 60% 25% at 30% 55%, rgba(140, 100, 60, 0.38) 0%, rgba(59, 20, 22, 0) 70%), #3B1416; }
  .cp-hero-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(42, 10, 11, 0.94) 0%, rgba(42, 10, 11, 0.4) 55%, rgba(42, 10, 11, 0.55) 100%); }
  .cp-corner { position: absolute; top: 121px; width: 24px; height: 24px; border: 0 solid var(--text-on-dark-muted); }
  .cp-corner--l { left: 32px; border-left-width: 1px; border-top-width: 1px; }
  .cp-corner--r { right: 32px; border-right-width: 1px; border-top-width: 1px; }
  .cp-hero-ph { position: absolute; left: var(--margin); top: 92px; font-size: 12px; color: var(--text-on-dark-muted); }
  .cp-hero-copy { position: relative; display: flex; flex-direction: column; gap: 18px; }
  .cp-h1 { font-family: var(--font-display); font-size: clamp(4.5rem, 2.643rem + 7.619vw, 9.5rem); font-weight: 500; line-height: 0.92; letter-spacing: -0.015em; }
  .cp-lead { font-family: var(--font-display); font-size: clamp(1.5rem, 1.257rem + 1vw, 2.125rem); font-weight: 500; line-height: 1.3; }
  .cp-hero-ctas { margin-top: 8px; display: flex; flex-direction: column; gap: 12px; }
  .cp-btn { display: flex; align-items: center; gap: 10px; min-height: 56px; border-radius: var(--radius-md); font-size: 16px; font-weight: 600; text-decoration: none; }
  .cp-btn--primary { justify-content: space-between; padding: 0 18px 0 20px; background: var(--brand); color: #FFFFFF; }
  .cp-btn--primary:hover { background: var(--brand-hover); color: #FFFFFF; }
  .cp-btn--outline { justify-content: center; padding: 0 24px; border: 1.5px solid var(--text-on-dark); color: var(--text-on-dark); }
  .cp-btn--outline:hover { background: rgba(251, 247, 240, 0.12); color: var(--text-on-dark); }

  /* ---------- figures ---------- */
  .cp-fig { padding: 48px 0 56px; border-bottom: 1px solid var(--border); }
  .cp-fig-head .eyebrow-text { font-size: 12px; }
  .cp-fig-dl { margin: 20px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--text); }
  .cp-fig-item { display: flex; flex-direction: column; gap: 6px; padding: 20px 12px 20px 0; border-bottom: 1px solid var(--border); }
  .cp-fig-item dt { order: 2; font-size: 15px; line-height: 1.4; }
  .cp-fig-item dd { order: 1; margin: 0; display: flex; align-items: baseline; gap: 6px; }
  .cp-fig-item--wide { grid-column: 1 / -1; padding-right: 0; }
  .cp-fig-item:nth-child(odd):not(.cp-fig-item--wide) { padding: 20px 0 20px 16px; border-left: 1px solid var(--border); }
  .cp-fig-num { font-family: var(--font-display); font-size: 56px; font-weight: 500; line-height: 0.9; color: var(--brand); }
  .cp-fig-item--wide .cp-fig-num { font-size: 64px; }
  .cp-fig-unit { font-size: 14px; color: var(--text-muted); }
  .cp-fig-item--wide .cp-fig-unit { font-size: 15px; }
  .cp-globe { height: 50px; display: flex; align-items: flex-end; color: var(--brand); }
  .cp-globe svg { width: 48px; height: 48px; stroke-width: 1.5; }
  .cp-fig-source { margin-top: 14px; font-size: 13px; color: var(--text-muted); }

  /* ---------- scenes ---------- */
  .cp-scn { padding: 56px 0 64px; }
  .cp-scn-title { display: flex; flex-direction: column; gap: 12px; }
  .cp-scn-title .eyebrow-text { font-size: 12px; }
  .cp-h2 { font-family: var(--font-display); font-size: clamp(2.5rem, 2.071rem + 1.714vw, 3.5rem); font-weight: 500; line-height: 1.05; }
  .cp-tabs { margin-top: 28px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-bottom: 1px solid var(--text); }
  .cp-tab { display: flex; align-items: center; justify-content: flex-start; min-height: 56px; padding: 0; border: 0; background: transparent; text-align: left; color: var(--text-muted); }
  .cp-tab-verb { font-family: var(--font-display); font-size: 25px; font-weight: 500; line-height: 1; }
  .cp-tab:hover .cp-tab-verb { color: var(--text); }
  .cp-tab[aria-selected='true'] { box-shadow: inset 0 -3px 0 var(--accent); }
  .cp-tab[aria-selected='true'] .cp-tab-verb { font-style: italic; color: var(--brand); }
  .cp-tab:focus-visible { outline-offset: -2px; }
  .cp-scn-panels { margin-top: 24px; display: flex; flex-direction: column; gap: 48px; }
  .cp-scn-panel { display: flex; flex-direction: column; gap: 16px; }
  .cp-scn-panel :global(.cp-scn-photo) { aspect-ratio: 4 / 3 !important; padding: 12px; font-size: 12px; }
  .cp-scn-text { display: flex; flex-direction: column; gap: 16px; }
  .cp-scn-verb { display: none; }
  :global(html:not(.js)) .cp-scn-verb { display: flex; }
  .cp-h3 { margin-top: 4px; font-family: var(--font-display); font-size: clamp(1.875rem, 1.457rem + 1.714vw, 2.5rem); font-weight: 500; line-height: 1.1; }
  .cp-scn-p { font-size: 17px; line-height: 1.6; }
  .cp-scn-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .cp-scn-link { display: grid; grid-template-columns: 36px 1fr auto; align-items: center; min-height: 52px; border-bottom: 1px solid var(--border); color: var(--text); text-decoration: none; }
  .cp-scn-link:hover { color: var(--text); }
  .cp-scn-link:hover .cp-scn-name { text-decoration: underline; text-underline-offset: 5px; }
  .cp-scn-link :global(svg) { color: var(--brand); }
  .cp-scn-num { font-size: 12px; font-weight: 700; color: var(--brand); }
  .cp-scn-name { font-size: 16px; font-weight: 600; }

  /* ---------- atlas ---------- */
  .cp-atlas { padding: 56px 0 64px; background: var(--surface-raised); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .cp-atlas-title { display: flex; flex-direction: column; gap: 12px; padding-bottom: 20px; border-bottom: 1px solid var(--text); }
  .cp-atlas-title .eyebrow-text { font-size: 12px; }
  .cp-atlas-h2 { font-family: var(--font-display); font-size: clamp(2.75rem, 2.1rem + 2.667vw, 4.5rem); font-weight: 500; line-height: 1; }
  .cp-atlas-list { list-style: none; margin: 0; padding: 0; }
  .cp-row { display: grid; grid-template-columns: 112px 1fr; grid-template-areas: 'thumb title' 'thumb desc' 'thumb link'; column-gap: 16px; row-gap: 4px; align-items: start; padding: 20px 0; border-bottom: 1px solid var(--border); scroll-margin-top: 80px; }
  .cp-row-thumb { grid-area: thumb; }
  .cp-row :global(.cp-thumb-ph) { padding: 6px; font-size: 10px; line-height: 1.25; }
  .cp-row-title { grid-area: title; display: flex; gap: 10px; align-items: baseline; }
  .cp-row-num { font-size: 12px; font-weight: 700; color: var(--brand); }
  .cp-row-name { font-family: var(--font-display); font-size: 24px; font-weight: 500; line-height: 1.1; }
  .cp-row-desc { grid-area: desc; font-size: 14px; line-height: 1.5; }
  .cp-row-link { grid-area: link; align-self: start; justify-self: start; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: 15px; font-weight: 600; color: var(--brand); text-decoration: underline; text-decoration-color: var(--link-underline); text-underline-offset: 5px; white-space: nowrap; }
  .cp-row-link:hover { text-decoration-thickness: 2px; text-decoration-color: currentColor; }
  .cp-also { margin-top: 20px; padding: 16px 0; border-top: 1px solid var(--text); display: grid; grid-template-columns: auto 1fr; column-gap: 10px; row-gap: 4px; align-items: baseline; }
  .cp-also-k { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }
  .cp-also-body { display: contents; }
  .cp-also-name { font-family: var(--font-display); font-size: 24px; font-weight: 500; line-height: 1.1; }
  .cp-also-p { grid-column: 1 / -1; font-size: 14px; line-height: 1.5; color: var(--text-muted); }

  /* ---------- closing ---------- */
  .cp-close { padding: 56px 0 64px; }
  .cp-close-grid { display: flex; flex-direction: column; gap: 32px; }
  .cp-tour { position: relative; display: block; aspect-ratio: 16 / 10; background: #3B1416; color: var(--text-on-dark); overflow: hidden; text-decoration: none; }
  .cp-tour:hover { color: var(--text-on-dark); }
  .cp-tour-bg { position: absolute; inset: 0; background: radial-gradient(ellipse 70% 55% at 60% 40%, rgba(96, 110, 60, 0.45) 0%, rgba(59, 20, 22, 0) 70%), linear-gradient(0deg, rgba(42, 10, 11, 0.88) 0%, rgba(42, 10, 11, 0.1) 65%); }
  .cp-tour-play { position: absolute; left: 50%; top: 40%; width: 72px; height: 72px; margin: -36px 0 0 -36px; border-radius: 50%; background: var(--accent); color: var(--text); display: flex; align-items: center; justify-content: center; }
  .cp-tour-play :global(svg) { width: 26px; height: 26px; }
  .cp-tour-foot { position: absolute; left: 16px; right: 16px; bottom: 14px; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .cp-tour-text { display: flex; flex-direction: column; gap: 4px; }
  .cp-tour-k { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .cp-tour-title { font-family: var(--font-display); font-size: 28px; font-weight: 500; line-height: 1; }
  .cp-tour-thumb { font-size: 13px; color: var(--text-on-dark-muted); }
  @media (prefers-reduced-motion: no-preference) {
    .cp-tour-play { transition: transform 200ms ease-out; }
    .cp-tour:hover .cp-tour-play { transform: scale(1.06); }
  }
  .cp-visit { display: flex; flex-direction: column; gap: 14px; }
  .cp-visit .eyebrow-text { font-size: 12px; }
  .cp-visit-h2 { font-family: var(--font-display); font-size: clamp(2.75rem, 2.229rem + 2.095vw, 4rem); font-weight: 500; line-height: 1; }
  .cp-visit-p { font-size: 17px; line-height: 1.6; }
  .cp-call { display: flex; justify-content: center; align-items: center; gap: 12px; min-height: 60px; border-radius: var(--radius-md); background: var(--brand); color: #FFFFFF; font-size: 19px; font-weight: 700; text-decoration: none; }
  .cp-call:hover { background: var(--brand-hover); color: #FFFFFF; }
  .cp-link { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 16px; font-weight: 600; color: var(--brand); text-decoration: underline; text-decoration-color: var(--link-underline); text-underline-offset: 6px; }
  .cp-link:hover { text-decoration-thickness: 2px; text-decoration-color: currentColor; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.swap-in) { animation: kb-fade 280ms ease-out both; }
  }

  @media (min-width: 1024px) {
    .cp-hero { min-height: 900px; padding-bottom: 88px; }
